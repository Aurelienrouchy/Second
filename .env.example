# Local runs always use Seconde Dev (seconde-dev).
# Public Firebase project tuples live in config/firebaseProjects.json.
# Old EXPO_PUBLIC_FIREBASE_* values do not override those tuples.
EXPO_PUBLIC_APP_ENV=development

# npm start uses cloud dev; npm run start:emulators selects demo-second.
# No fallback to the cloud if emulators are down.
EXPO_PUBLIC_FIREBASE_EMULATORS=0
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Optional, dedicated DEV providers. Leave blank until configured.
EXPO_PUBLIC_DEV_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_DEV_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_DEV_ANDROID_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_DEV_IOS_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_DEV_POSTHOG_API_KEY=
EXPO_PUBLIC_DEV_POSTHOG_HOST=

# Public commerce flags belong to the matching EAS development/production
# environment. Only the exact value true opens the client rail; default is OFF.
# Server rails and provider qualification must be configured separately first.
EXPO_PUBLIC_PAYMENTS_ENABLED=false
EXPO_PUBLIC_SHIPPING_ENABLED=false

# Development defaults to the dedicated Seconde Dev Stripe sandbox test key.
# Production payments require an explicit pk_live_ key in EAS production.
# Never put Stripe secret keys or ShipEngine API keys in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_USE_RN_FETCH=1

# Production analytics belong in the EAS production environment only.
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
