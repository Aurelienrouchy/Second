{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Seconde Dev",
        "supportEmail": "rouchy.aurelien@gmail.com",
        "authorizedRedirectUris": [
          "https://seconde-dev.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
    "runtime": "nodejs22",
    "ignore": [
      "node_modules", ".git", ".firebase", "firebase-debug.log", "firebase-debug.*.log", "*.local",
      ".env*", "**/*.test.ts", "**/*.spec.ts", "**/*.test.js", "**/*.spec.js",
      "**/*.test.js.map", "**/*.spec.js.map", "lib-scripts", "coverage", ".vitest"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
