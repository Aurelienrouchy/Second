rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for validation and authorization
    // Auth token revocation alone does not invalidate a cached JWT in Rules.
    // The server-only containment marker also fences private reads/writes.
    // A later sign-in restores historical access, not commercial permission.
    function sessionAfterSecurityBarrier(profile) {
      let barrier = profile.get('accountSecurityBarrier', null);
      // Legacy deletion is permanent for every cached/new JWT. Even malformed
      // or null native markers stay closed after users/{uid} is removed.
      return !('accountErasureFence' in profile) && !('legacyDeletionFence' in profile) &&
        (!('accountSecurityBarrier' in profile) ||
        (barrier is map && barrier.schemaVersion == 1 &&
         barrier.ownerId == request.auth.uid &&
         barrier.source == 'owner_security_request' && barrier.accepted == true &&
         barrier.statementVersion == 'account_security_containment_v1' &&
         barrier.newEffectsBlocked == true &&
         barrier.requestId is string && barrier.requestId.matches('[A-Za-z0-9_-]{1,128}') &&
         barrier.commandId is string && barrier.commandId.matches('security_[a-f0-9]{64}') &&
         barrier.inputHash is string && barrier.inputHash.matches('[a-f0-9]{64}') &&
         barrier.recordedAt is timestamp && barrier.recordedAt.toMillis() > 0 &&
         barrier.recordedAt <= request.time && request.auth.token.auth_time is int &&
         request.auth.token.auth_time * 1000 > barrier.recordedAt.toMillis()));
    }
    function isAuthenticated() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/eligibility_profiles/$(request.auth.uid)) ||
         sessionAfterSecurityBarrier(get(/databases/$(database)/documents/eligibility_profiles/$(request.auth.uid)).data));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function accountHasNoErasureFence(userId) {
      return !exists(/databases/$(database)/documents/eligibility_profiles/$(userId)) ||
        !('accountErasureFence' in get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data);
    }

    // Server-only permanent closure survives deletion of users/{uid}. A cached
    // signed Auth token cannot recreate the public account after its removal.
    function accountHasNoClosure(userId) {
      return !exists(/databases/$(database)/documents/eligibility_profiles/$(userId)) ||
        !('accountClosure' in get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data) ||
        get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data.accountClosure == null;
    }
    function canUpdateOwnerSource(userId) {
      return accountHasNoClosure(userId) ||
        (get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data.accountClosure is map &&
         get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data.accountClosure.schemaVersion == 1 &&
         get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data.accountClosure.ownerId == userId &&
         get(/databases/$(database)/documents/eligibility_profiles/$(userId)).data.accountClosure.phase == 'paused');
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }
    
    function isValidPrice(price) {
      return price is number && price >= 0.01 && price <= 10000;
    }
    
    // ── Bascule de déploiement échelonné ────────────────────────────────────
    // Trois verrous ci-dessous dépendent d'un code CLIENT qui voyage dans le
    // BUILD de l'application, pas dans ce déploiement. Les builds déjà installés
    // sur les téléphones écrivent encore eux-mêmes, à la finalisation d'une
    // rencontre, `offer.meetup.completedAt` et `offer.status = 'completed'`, et
    // postent eux-mêmes les messages « système » de la conversation. Les activer
    // maintenant ferait échouer ces écritures : messages d'information perdus en
    // silence, et erreur affichée à l'utilisateur APRÈS une finalisation
    // pourtant réussie côté serveur — l'état resterait correct, le message
    // serait faux.
    //
    // PASSER À `true` dès qu'un build embarquant le routage serveur est en
    // circulation, et réactiver au même moment les trois groupes de tests
    // marqués « TRANSITOIRE » dans tests/security/messages.rules.test.ts.
    function strictOfferClientWrites() {
      return true;
    }

    // ── Deuxième bascule : l'écriture cliente directe d'un ARTICLE ──────────
    // L'app n'écrit plus un article qu'à travers les callables `createArticle`,
    // `updateArticle` et `toggleArticleSold` depuis le 2026-05-25. Les builds
    // antérieurs, eux, créent l'article par `addDoc` (date posée par le
    // téléphone, `images: []`) puis y posent les images par `updateDoc`, et
    // éditent par `updateDoc`. Fermer maintenant leur interdirait de publier.
    //
    // En attendant, la règle refuse tout ce qu'aucun client légitime, ancien
    // ou actuel, n'écrit : un article qui naît vendu, une date qui n'en est
    // pas une ou qui est dans le futur, une boutique, une baisse de prix,
    // l'identité affichée du vendeur, l'édition d'un article vendu, la
    // suppression dure (tests/security/articles.rules.test.ts).
    //
    // PASSER À `true` quand plus aucun build antérieur au 2026-05-25 ne
    // circule : toute écriture cliente d'article sera alors refusée.
    function strictArticleClientWrites() {
      return true;
    }

    function isAdmin() {
      // A present native field is authoritative, including explicit revocation
      // or malformed values. Absent fields retain historical claims-only use.
      let privateUser = request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
      return isAuthenticated() &&
        (!('isActive' in privateUser) || privateUser.isActive == true) &&
        ('isAdmin' in privateUser ? privateUser.isAdmin == true : request.auth.token.get('admin', false) == true);
    }

    // This check grants no role. It only fences existing moderator claims
    // when the native account has been deactivated or its state is malformed.
    function administrativeAccountActive() {
      let privateUser = request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
      return isAuthenticated() && (!('isActive' in privateUser) || privateUser.isActive == true);
    }

    // True when `viewerUid` is NOT blocked by `ownerUid`. Reads the owner's
    // user doc via get() (which bypasses the users read rule). Enforcement is
    // based on the flat `blockedUserIds` list (a list of plain UIDs). When that
    // field is absent (doc not yet migrated) the check passes — defence in depth
    // alongside the Cloud Function block guards; it never produces false blocks.
    function isNotBlockedBy(ownerUid, viewerUid) {
      return !(exists(/databases/$(database)/documents/users/$(ownerUid)) &&
               'blockedUserIds' in get(/databases/$(database)/documents/users/$(ownerUid)).data &&
               viewerUid in get(/databases/$(database)/documents/users/$(ownerUid)).data.blockedUserIds);
    }

    // Symmetric block check between two UIDs (neither may have blocked the
    // other). Used wherever a message/chat write must be denied as soon as a
    // block exists in EITHER direction — matching the Cloud Function trigger
    // and services/moderationService.ts semantics.
    function neitherBlocks(uidA, uidB) {
      return isNotBlockedBy(uidA, uidB) && isNotBlockedBy(uidB, uidA);
    }

    // The "other" participant of a 2-party chat, derived from the SERVER chat
    // doc (never from a client-supplied receiverId). Assumes the caller has
    // already verified the chat exists with exactly 2 participants including
    // senderUid. Returns the participant that is not senderUid.
    function chatCounterparty(chatId, senderUid) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0] == senderUid
        ? get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
        : get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0];
    }

    // L'autre participant, lu dans un document `chats` DÉJÀ chargé — donc sans
    // `get()`, contrairement à `chatCounterparty` qui en consomme jusqu'à trois.
    function chatOtherOf(participants, uid) {
      return participants[0] == uid ? participants[1] : participants[0];
    }

    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }
    
    function isValidCondition(condition) {
      return condition in ['neuf', 'neuf sans étiquette', 'très bon état',
                          'bon état', 'satisfaisant'];
    }
    
    function isValidCoordinates(coords) {
      return coords is map &&
             coords.keys().hasAll(['lat', 'lon']) &&
             coords.lat is number && coords.lat >= -90 && coords.lat <= 90 &&
             coords.lon is number && coords.lon >= -180 && coords.lon <= 180;
    }
    
    // Shops Collection Rules
    match /shops/{shopId} {
      function serverFinancialFields() {
        return ['plan', 'forfait', 'tier', 'tierPaidUntil', 'tierPaymentIntentId',
                'tierChargeId', 'feesTier', 'buyerFeePercent', 'financialRecoveryWitness'];
      }
      // Whole legacy documents may contain fiscal/bank information. Public
      // discovery uses the server allowlist, never a field-masking rule.
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.get('ownerId', null) == request.auth.uid);

      // Allow create for authenticated users — but the owner can NEVER
      // self-approve at creation. SECURITY (B1): the validation/moderation
      // status and verification metadata are admin-owned. A new shop must
      // start as 'pending' (or omit status entirely; the service defaults to
      // 'pending'); it may never be created already 'approved'. The paid
      // forfait/plan fields are also admin/Cloud-Function owned: a client must
      // not grant itself a paid tier (which lowers buyer fees) at create time.
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId &&
                       (!('status' in request.resource.data) ||
                        request.resource.data.status == 'pending') &&
                       !request.resource.data.keys().hasAny(
                         ['legalInfo', 'verificationDetails', 'isVerified']) &&
                       !request.resource.data.keys().hasAny(serverFinancialFields());

      // Allow update either by an admin (moderation: approve / reject /
      // suspend) OR by the owner for non-sensitive
      // fields only. SECURITY (B1/B2/B3): a shop owner can edit their profile
      // (name, description, images, hours, contact…) but can NEVER mutate the
      // validation status, the verification metadata, or the paid forfait /
      // fee tier. Self-approval and self-upgrade are rejected; those mutations
      // are reserved to Cloud Functions. Even an admin client cannot grant a
      // paid entitlement or forge an epoch/source witness on restored data.
      // Launch exclusion: no client, including an admin, may ingest/change
      // these identifiers. An unchanged historical map remains readable only
      // by its owner/admin and does not block unrelated profile moderation.
      allow update: if isAuthenticated() &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['legalInfo']) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFinancialFields()) &&
                       (
                         isAdmin() ||
                         (request.auth.uid == resource.data.ownerId &&
                          request.auth.uid == request.resource.data.ownerId &&
                          !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['ownerId', 'status', 'verificationDetails',
                                      'plan', 'forfait', 'tier', 'tierPaidUntil',
                                      'tierPaymentIntentId', 'tierChargeId',
                                      'feesTier', 'buyerFeePercent', 'isVerified']))
                       );

      // No delete allowed (admins suspend via status; hard delete is CF-only).
      allow delete: if false;
    }

    // Brands Collection Rules
    match /brands/{brandId} {
      allow read: if true;
      // Allow authenticated users to create custom brands
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['label', 'value', 'searchKey']) &&
                       request.resource.data.isCustom == true;
      // Update and delete only via admin/script
      allow update, delete: if false;
    }

    // Notifications Collection Rules
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if false; // Only cloud functions can create notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Articles Collection Rules
    match /articles/{articleId} {
      // Public read (browse / discovery uses unauthenticated reads).
      allow read: if true;

      // Écriture directe tolérée pour les builds antérieurs au 2026-05-25 —
      // voir strictArticleClientWrites().
      allow create: if !strictArticleClientWrites() &&
                       isAuthenticated() &&
                       request.auth.uid == request.resource.data.sellerId &&
                       isValidArticleData(request.resource.data);

      allow update: if !strictArticleClientWrites() &&
                       isAuthenticated() &&
                       request.auth.uid == resource.data.sellerId &&
                       isValidArticleUpdate(resource.data, request.resource.data);

      // Aucun client n'a jamais supprimé un article en dur : les builds
      // antérieurs le désactivaient déjà (`isActive: false`) et l'app actuelle
      // passe par la callable `updateArticle`. Une suppression dure échappait
      // au verrou « transaction en cours » et ne nettoyait rien derrière elle.
      allow delete: if false;

      // Champs que SEUL le serveur pose.
      function serverOnlyArticleFields() {
        return ['shopId', 'originalPrice', 'priceDropPercent', 'lastPriceDropAt', 'isPromoted', 'privacyWithdrawal'];
      }

      // Une liste, jamais plus de dix : une valeur d'un autre type faisait
      // planter le parcours et la recherche de TOUS les utilisateurs.
      function isValidArticleImages(images) {
        return images is list && images.size() <= 10;
      }

      function isValidArticleData(data) {
        return data.keys().hasAll(['title', 'price', 'sellerId', 'isActive', 'isSold', 'createdAt', 'images']) &&
               isValidString(data.title, 3, 200) &&
               isValidPrice(data.price) &&
               data.sellerId == request.auth.uid &&
               data.isActive is bool &&
               // Un article ne naît jamais vendu : le passage à « vendu » est
               // réservé aux callables serveur. Sans cela, n'importe qui
               // fabriquait son compteur public « articles vendus ».
               data.isSold == false &&
               // Une date, et pas dans le futur : une date d'une autre nature
               // faisait planter le catalogue pour tous, une date lointaine
               // épinglait l'annonce en tête des tris par récence. Les builds
               // antérieurs posent une date CLIENT, d'où une tolérance d'horloge
               // plutôt qu'une égalité à request.time.
               data.createdAt is timestamp &&
               data.createdAt <= request.time + duration.value(5, 'm') &&
               // Le champ existe toujours, fût-il vide : les builds antérieurs
               // au 2026-05-25 créent l'annonce avec `images: []` puis y posent
               // les photos par un second appel. Exiger une photo DÈS la
               // création casserait leur publication ; la garde « en ligne ⇒ au
               // moins une photo » vit donc côté mise à jour, et la naissance
               // sans photo ne se ferme qu'avec strictArticleClientWrites().
               isValidArticleImages(data.images) &&
               !data.keys().hasAny(serverOnlyArticleFields()) &&
               (!('description' in data) || isValidString(data.description, 0, 5000)) &&
               // L'état et les coordonnées n'étaient validés nulle part : un état
               // inventé sortait l'annonce du filtre « État », et une latitude
               // texte empoisonnait le géohash que la recherche par proximité
               // recalcule à chaque écriture.
               (!('condition' in data) || isValidCondition(data.condition)) &&
               (!('location' in data) || !(data.location is map) ||
                !('coordinates' in data.location) ||
                isValidCoordinates(data.location.coordinates)) &&
               // moderationStatus must be 'approved' if provided (auto-approved for now)
               (!('moderationStatus' in data) || data.moderationStatus == 'approved') &&
               // Server-managed counters must start at zero
               (!('views' in data) || data.views == 0) &&
               (!('likes' in data) || data.likes == 0) &&
               (!('favoritesCount' in data) || data.favoritesCount == 0);
      }

      function isValidArticleUpdate(oldData, newData) {
        // Un article vendu ne se modifie plus — le serveur le refuse aussi
        // (`updateArticle`). Sans cette garde, un vendeur réécrivait titre,
        // photos et prix d'un article vendu, et la réécriture se propageait
        // dans la conversation de l'acheteur.
        return !('privacyWithdrawal' in oldData) &&
               !('privacyWithdrawal' in newData) &&
               oldData.get('isSold', false) != true &&
               newData.sellerId == oldData.sellerId &&
               isValidString(newData.title, 3, 200) &&
               isValidPrice(newData.price) &&
               (!('description' in newData) || isValidString(newData.description, 0, 5000)) &&
               (!('images' in newData) || isValidArticleImages(newData.images)) &&
               // Une annonce EN LIGNE porte au moins une photo. Le serveur le
               // refuse déjà (`updateArticle`) ; la règle, elle, laissait vider
               // la galerie ou effacer le champ — fiche sans image au catalogue,
               // dans la recherche et dans la conversation. La garde ne mord que
               // sur un article qui en avait un (les documents antérieurs sans
               // champ `images` restent modifiables), et retirer l'annonce de la
               // vitrine reste toujours possible : c'est ainsi que les builds
               // antérieurs suppriment.
               (!('images' in oldData) ||
                newData.get('isActive', false) != true ||
                newData.get('images', []).size() >= 1) &&
               (!('condition' in newData) || isValidCondition(newData.condition)) &&
               (!('location' in newData) || !(newData.location is map) ||
                !('coordinates' in newData.location) ||
                isValidCoordinates(newData.location.coordinates)) &&
               // Posés par le serveur, jamais par le client : date de création,
               // boutique, suivi de baisse de prix, identité affichée du vendeur
               // (relue du profil par le serveur à chaque changement).
               fieldPreserved(oldData, newData, 'createdAt') &&
               fieldPreserved(oldData, newData, 'shopId') &&
               fieldPreserved(oldData, newData, 'originalPrice') &&
               fieldPreserved(oldData, newData, 'priceDropPercent') &&
               fieldPreserved(oldData, newData, 'lastPriceDropAt') &&
               fieldPreserved(oldData, newData, 'isPromoted') &&
               fieldPreserved(oldData, newData, 'sellerName') &&
               fieldPreserved(oldData, newData, 'sellerImage') &&
               // Protect server-managed fields from client mutation
               // La forme `!('X' in newData) || newData.X == oldData.X` était
               // contournable par SUPPRESSION : `newData` est le document tel
               // qu'il sera APRÈS écriture, donc un `update({X: deleteField()})`
               // rend `'X' in newData` faux et la garde passe. Un vendeur
               // pouvait ainsi effacer `isSold` d'un article verrouillé par une
               // rencontre en cours et le remettre en vente, ou effacer
               // `moderationStatus` pour sortir de la modération.
               // On exige donc que le champ SURVIVE et reste égal dès lors
               // qu'il existait.
               fieldPreserved(oldData, newData, 'views') &&
               fieldPreserved(oldData, newData, 'likes') &&
               fieldPreserved(oldData, newData, 'favoritesCount') &&
               fieldPreserved(oldData, newData, 'moderationStatus') &&
               fieldPreserved(oldData, newData, 'isSold');
      }

      /**
       * Vrai si `field` est resté strictement identique — présent des deux
       * côtés avec la même valeur, ou absent des deux côtés. Interdit donc
       * autant la modification que la SUPPRESSION du champ.
       */
      function fieldPreserved(oldData, newData, field) {
        return (field in oldData)
          ? ((field in newData) && newData[field] == oldData[field])
          : !(field in newData);
      }
    }

    // Products Collection Rules
    // DEPRECATED: The client uses `articles` collection exclusively.
    // These rules existed for a legacy `products` collection that is no
    // longer written to or read from by any client code. Locked down to
    // prevent accidental use. Kept as a placeholder until the collection
    // is fully removed from Firestore.
    match /products/{productId} {
      allow read, write: if false;
    }
    
    // Users Collection Rules
    match /users/{userId} {
      // SECURITY: restrict reads to the document owner or admins.
      // Public profile data (displayName, profileImage, rating, etc.) is served
      // via the getUserPublicProfile callable (Admin SDK). Client-side code
      // reading other users' docs (e.g. chatService.ts) must migrate to that
      // callable. BREAKING CHANGE: any direct getDoc(users/X) where X != caller
      // will now fail.
      allow read: if isOwner(userId) || isAdmin();

      // Allow create only with valid initial data. The isAdmin/role/claims
      // fields cannot be set by clients on creation either.
      // SECURITY: `username` is the persistent, unique, immutable handle assigned
      // EXCLUSIVELY server-side by the assignUsername callable (Admin SDK) right
      // after the doc is created. The client creates the users doc WITHOUT a
      // username, so it must be absent at create time.
      //
      // `id`, `createdAt` and `isActive` are legitimately initialized by the
      // three signup setDoc paths, so they are removed
      // from the forbidden-at-create set — but kept anti-forge:
      //   - if `id` is present it MUST equal userId (== request.auth.uid via
      //     isOwner), so a client can't seed a foreign id; and
      //   - if `createdAt` is present it MUST equal request.time, which is exactly
      //     what a client serverTimestamp() resolves to at create, blocking any
      //     backdating/forging of the creation timestamp.
      // isActive may be absent for legacy compatibility, or exactly true at
      // creation. After creation all three are immutable to clients.
      allow create: if isOwner(userId) &&
                       accountHasNoClosure(userId) &&
                       isValidUserData(request.resource.data) &&
                       !request.resource.data.keys().hasAny(createForbiddenUserFields()) &&
                       (!('id' in request.resource.data) ||
                          request.resource.data.id == userId) &&
                       (!('createdAt' in request.resource.data) ||
                          request.resource.data.createdAt == request.time);

      // Allow update by owner — but never to fields that grant privileges.
      // SECURITY: previously a user could write { isAdmin: true } to their
      // own document and pass UI-side admin checks. Privileged fields must
      // be set out-of-band (Cloud Function with Admin SDK + Auth custom claim).
      // `username` is in the protected set: it is server-assigned and IMMUTABLE,
      // so a client can never add it, change it, or remove it.
      allow update: if isOwner(userId) &&
                       canUpdateOwnerSource(userId) &&
                       !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(protectedUserFields()) &&
                       // `displayName` n'était validé qu'à la CRÉATION. Il pouvait
                       // ensuite devenir n'importe quoi — une chaîne vide, mille
                       // caractères, ou « Second — Support ». Ce nom est propagé
                       // par un trigger dans l'instantané `participantsInfo` de
                       // TOUTES les conversations, et c'est le seul nom que voit
                       // l'autre partie. Sur un échange comptant sans séquestre,
                       // se faire passer pour la plateforme est le levier
                       // d'arnaque le plus direct qui soit.
                       // Borne haute à 150, et non 50 comme à la création.
                       //
                       // Les connexions Google et Apple rattrapent un nom
                       // « générique » en écrivant celui du fournisseur, qui n'est
                       // borné par rien (`services/authService.ts`). Le client le
                       // tronque désormais à 50 — mais les BUILDS INSTALLÉS, où ce
                       // code vit depuis le 2026-05-23, ne le tronquent pas. Une
                       // borne à 50 aurait fait ÉCHOUER leur connexion : le
                       // `updateDoc` lève, le `catch` rend « Erreur lors de la
                       // connexion. Veuillez réessayer. », et le retry échoue à
                       // l'identique — la personne est enfermée dehors de son
                       // compte.
                       //
                       // 150 ne coûte rien à l'objectif, qui est d'empêcher un nom
                       // VIDE et l'usurpation : se faire passer pour « Second —
                       // Support » demande un nom court et crédible, jamais un nom
                       // de cent cinquante caractères. Ce qui protège, c'est le
                       // minimum de 1 et le fait que le champ soit typé.
                       (!request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(['displayName']) ||
                        isValidString(request.resource.data.displayName, 1, 150));

      // Single source of truth for fields the CLIENT may never set or mutate on
      // its own user doc — applied identically to create and update so a forged
      // initial doc can't bypass the update lock.
      //
      // - isAdmin/role/customClaims : privilege escalation (see isAdmin()).
      // - username                  : server-assigned, persistent, IMMUTABLE handle.
      // - onboardingCompleted/createdAt/id/isActive : server-managed lifecycle/identity fields.
      // - stripe*                   : the ONLY financial gates read by walletWithdraw /
      //   createTransaction / swaps. Written EXCLUSIVELY by the Stripe webhook +
      //   onboarding callables (Admin SDK, which bypasses these rules). Leaving them
      //   client-writable let a seller redirect their real payout to a third party's
      //   stripeAccountId and force charges/payouts booleans true to skip KYC.
      // - dateOfBirth               : Loi 25 consent-gate + age-gate, set ONLY in the
      //   server-side signup setDoc; a client must never self-set or alter it.
      // - isVerified/rating/reviewCount/sellerLikesCount : trust signals served by
      //   getUserPublicProfile; server-managed, never client-forgeable.
      //
      // NOTE: accountType ('user' | 'shop') is intentionally NOT protected — it is a
      // legitimate client write (userService.updateAccountType) and is not a financial
      // gate (the seller-active gate keys off stripeAccountId + stripeChargesEnabled).
      function protectedUserFields() {
        return [
          'isAdmin', 'role', 'customClaims', 'username',
          'onboardingCompleted', 'createdAt', 'id', 'isActive',
          'stripeAccountId', 'stripeChargesEnabled', 'stripePayoutsEnabled',
          'stripeAccountStatus', 'stripeDetailsSubmitted', 'stripeBankAccountAdded',
          'stripeBankAccountLast4', 'stripeBankAccountStatus',
          'stripeRequirementsCurrentlyDue', 'stripeRequirementsPastDue',
          'stripeRequirementsDisabledReason', 'stripeRequirementsCurrentDeadline',
          'stripeAccountCreatedAt', 'stripeAccountCreationStartedAt',
          'dateOfBirth', 'dateOfBirthVersion', 'eligibility', 'sellerActivity', 'sellerAdmission',
          'sellerQuebecEvidence', 'connectOperation',
          'isVerified', 'rating', 'reviewCount', 'reviewStatsQualification', 'sellerLikesCount'
        ];
      }

      // Fields the CLIENT may never set AT CREATE. Identical to
      // protectedUserFields() MINUS 'id', 'createdAt' and 'isActive', which are the
      // privileged-by-default fields a legitimate signup setDoc seeds. They are
      // not free-form at create: the create rule additionally enforces
      // id == userId, createdAt == request.time and isActive == true if present.
      // Every other
      // privilege/financial/trust field stays forbidden at create, exactly as in
      // protectedUserFields().
      function createForbiddenUserFields() {
        return [
          'isAdmin', 'role', 'customClaims', 'username',
          'onboardingCompleted',
          'stripeAccountId', 'stripeChargesEnabled', 'stripePayoutsEnabled',
          'stripeAccountStatus', 'stripeDetailsSubmitted', 'stripeBankAccountAdded',
          'stripeBankAccountLast4', 'stripeBankAccountStatus',
          'stripeRequirementsCurrentlyDue', 'stripeRequirementsPastDue',
          'stripeRequirementsDisabledReason', 'stripeRequirementsCurrentDeadline',
          'stripeAccountCreatedAt', 'stripeAccountCreationStartedAt',
          'dateOfBirth', 'dateOfBirthVersion', 'eligibility', 'sellerActivity', 'sellerAdmission',
          'sellerQuebecEvidence', 'connectOperation',
          'isVerified', 'rating', 'reviewCount', 'reviewStatsQualification', 'sellerLikesCount'
        ];
      }

      // No client delete or client account-standing transition.
      allow delete: if false;

      function isValidUserData(data) {
        return data.keys().hasAll(['email', 'displayName']) &&
               isValidEmail(data.email) &&
               isValidString(data.displayName, 1, 50) &&
               (!('isActive' in data) || data.isActive == true);
      }

      // Saved Searches Subcollection Rules
      match /savedSearches/{searchId} {
        // Allow read only by owner
        allow read: if isOwner(userId);

        // Allow create by owner
        allow create: if isOwner(userId) && canUpdateOwnerSource(userId);

        // Allow update by owner
        allow update: if isOwner(userId) && canUpdateOwnerSource(userId);

        // Allow delete by owner
        allow delete: if isOwner(userId);
      }

      // Search History Subcollection Rules
      match /searchHistory/{historyId} {
        // Allow read only by owner
        allow read: if isOwner(userId);

        // Allow create by owner
        allow create: if isOwner(userId) && canUpdateOwnerSource(userId);

        // Allow update by owner — the recent-search dedup path re-stamps an
        // existing entry (e.g. searchedAt) via updateDoc; without this the
        // dedup write is denied. Mirrors the savedSearches update rule above.
        allow update: if isOwner(userId) && canUpdateOwnerSource(userId);

        // Allow delete by owner
        allow delete: if isOwner(userId);
      }

      // Consents Subcollection Rules (legal consent records — CGU, politique de
      // confidentialité, marketing). Written EXCLUSIVELY server-side by the
      // recordSignupConsent callable (Admin SDK bypasses these rules) so the
      // acceptedAt timestamp and version stay authoritative and tamper-proof.
      match /consents/{consentId} {
        // Owner may read their own consent history.
        allow read: if isOwner(userId);

        // No client writes — server-only.
        allow create, update, delete: if false;
      }
    }

    // Usernames uniqueness registry — usernames/{username} -> { uid, createdAt }.
    // Reserved and written EXCLUSIVELY server-side by the assignUsername callable
    // (Admin SDK, within a runTransaction) to guarantee atomic uniqueness of the
    // persistent, immutable @handle. Fully server-only: no client read (the
    // mapping leaks nothing useful and a public read would enable username
    // enumeration), no client write of any kind.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Favorites Collection Rules
    // Unified structure: { userId, articleIds[], updatedAt }
    match /favorites/{userId} {
      // Allow read only by owner
      allow read: if isOwner(userId);

      // Allow write by owner with valid data
      allow write: if isOwner(userId) && isValidFavoritesData(request.resource.data);

      function isValidFavoritesData(data) {
        return data.userId == request.auth.uid &&
               data.articleIds is list &&
               data.articleIds.size() <= 500 &&
               validArticleIds(data.articleIds);
      }

      function validArticleIds(ids) {
        // Rules cannot loop over a list. Round-tripping the joined string
        // rejects non-string elements and embedded path separators. Keep each
        // ID below 375 characters (<= 1500 UTF-8 bytes) and reject reserved IDs.
        let joined = ids.join('/');
        return ids.size() == 0 ||
               (joined.split('/') == ids &&
                joined.matches('[^/]{1,375}(/[^/]{1,375})*') &&
                !joined.matches('([^/]+/)*[.]{1,2}(/[^/]+)*') &&
                !joined.matches('([^/]+/)*__[^/]*__(/[^/]+)*'));
      }
    }
    // Server projection acknowledgment for the owner's optimistic like count.
    match /favorite_memberships/{articleId}/users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    
    // Messages Collection Rules
    match /messages/{messageId} {
      // Allow read if:
      //   - the message has a participants list and the caller is in it; OR
      //   - the message lacks participants (legacy docs) BUT the parent
      //     chat doc lists the caller as a participant.
      allow read: if isAuthenticated() &&
                     (
                       ('participants' in resource.data &&
                        request.auth.uid in resource.data.participants) ||
                       ('chatId' in resource.data &&
                        exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
                        request.auth.uid in
                          get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
                     );

      // Offers and system events are exclusively created by server transitions.
      allow create: if isAuthenticated() &&
                       isValidMessageCreate(request.resource.data);

      // A receipt belongs to the receiver. Offer terms/status remain server-only.
      allow update: if isAuthenticated() &&
                       resource.data.receiverId == request.auth.uid &&
                       (
                         ('participants' in resource.data &&
                          request.auth.uid in resource.data.participants) ||
                         ('chatId' in resource.data &&
                          exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
                          request.auth.uid in
                            get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
                       ) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isRead', 'status']) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isRead']) ||
                        request.resource.data.isRead == true) &&
                       // Clients can acknowledge delivery/read, never reset it.
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                        request.resource.data.status in ['delivered', 'read']);

      // No delete allowed
      allow delete: if false;

      function isValidMessageCreate(data) {
        return data.senderId == request.auth.uid &&
               accountHasNoErasureFence(data.receiverId) &&
               data.keys().hasOnly(['chatId', 'senderId', 'receiverId', 'participants', 'type', 'content', 'text', 'timestamp', 'status', 'isRead', 'image']) &&
               (!('content' in data) || isValidString(data.content, 0, 5000)) &&
               (!('text' in data) || isValidString(data.text, 0, 5000)) &&
               data.senderId != data.receiverId &&
               data.type in ['text', 'image'] &&
               !data.keys().hasAny(['offer']) &&
               data.chatId is string &&
               data.participants is list &&
               data.participants.size() == 2 &&
               request.auth.uid in data.participants &&
               // Verify the referenced chat exists and the caller is a participant
               exists(/databases/$(database)/documents/chats/$(data.chatId)) &&
               get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants is list &&
               get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants.size() == 2 &&
               request.auth.uid in get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants &&
               data.receiverId == chatCounterparty(data.chatId, data.senderId) &&
               data.participants.toSet() == get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants.toSet() &&
               // SECURITY (M2): a blocked user cannot message someone who has
               // blocked them — IN A PRE-EXISTING CHAT TOO. The block check is
               // based on the AUTHORITATIVE counterparty derived from the server
               // chat doc, NOT the client-supplied `receiverId` (which a blocked
               // sender could forge to a third party who hasn't blocked them to
               // slip a message to the real victim). Symmetric: neither side may
               // have blocked the other. The Cloud Function trigger
               // (sendMessageNotification) is the authoritative belt-and-braces
               // guard that also covers any client/rule mismatch.
               neitherBlocks(data.senderId,
                             chatCounterparty(data.chatId, data.senderId));
      }

    }
    
    // Stats Collection Rules (Read-only for clients, write via Cloud Functions)
    match /stats/{statType} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      
      // No direct writes allowed (managed by Cloud Functions)
      allow write: if false;
    }
    
    // Search Index Collection Rules (Read-only for clients)
    match /search_index/{productId} {
      // Allow read for searching
      allow read: if true;

      // No direct writes allowed (managed by Cloud Functions)
      allow write: if false;
    }

    // Complete source snapshots and token/generation lineage are private.
    // Only allowlisted owner/actual-party callables expose qualified evidence.
    match /article_privacy_evidence/{articleId} {
      allow read: if isAdmin();
      allow write: if false;
      match /public_projection_evidence/{projectionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /profile_privacy_media/{uid}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /article_media_promotions/{promotionId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /article_privacy_commands/{commandId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Embeddings Collection Rules (for AI-powered similarity search)
    match /embeddings/{articleId} {
      // Allow read for similarity search queries
      allow read: if true;

      // No direct writes allowed (managed by Cloud Functions)
      allow write: if false;
    }

    // Moments Collection Rules (for seasonal/event-based product discovery)
    match /moments/{momentId} {
      // Allow read for moment-based product sections
      allow read: if true;

      // No direct writes allowed (managed by scripts/Cloud Functions)
      allow write: if false;
    }

    // ============================================
    // SWAP SYSTEM RULES
    // ============================================

    // Swap Parties (the single permanent generalist Swap Zone)
    match /swapParties/{partyId} {
      // Anyone can read the zone (counters: itemsCount, swapsCount).
      allow read: if true;

      // Create / update / delete only via Cloud Functions (Admin SDK):
      // ensureGeneralistZone bootstraps the zone; addItemToPartySecure /
      // removeItemFromPartySecure / confirmSwapReception maintain the counters
      // atomically. No client-side writes.
      allow create, update, delete: if false;
    }

    // Swap Zone Items
    // Public discovery has no membership requirement. NEW deposits must pass
    // addItemToPartySecure, which checks native ownership and private launch
    // admission (18+, personal activity, declared Québec residence) and keeps
    // itemsCount in sync. Existing owner withdrawal remains accessible.
    match /swapPartyItems/{itemId} {
      // Anyone can read items in the zone (public discovery + home preview).
      allow read: if true;
      function respectsPublicPhoto(data, userId) {
        return data.get('sellerImage', null) == null ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
           get(/databases/$(database)/documents/users/$(userId)).data.get('preferences', {}).get('privacy', {}).get('showProfilePhoto', false) == true &&
           data.sellerImage == get(/databases/$(database)/documents/users/$(userId)).data.get('profileImage', null));
      }

      // Admin SDK callable only. Direct creation would bypass the private
      // participant admission even with correct ownership and false flags.
      allow create: if false;
      allow delete: if isAuthenticated() &&
                       resource.data.sellerId == request.auth.uid;

      // SECURITY: isSwapped and isPending are managed exclusively by Cloud
      // Functions (Admin SDK). Clients cannot mark items swapped or manipulate
      // the pending lock.
      allow update: if isAuthenticated() &&
                       resource.data.sellerId == request.auth.uid &&
                       !('privacyWithdrawal' in resource.data) &&
                       !('privacyWithdrawal' in request.resource.data) &&
                       !('privacyWithdrawal' in get(/databases/$(database)/documents/articles/$(resource.data.articleId)).data) &&
                       respectsPublicPhoto(request.resource.data, request.auth.uid) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['isSwapped', 'isPending', 'articleId', 'sellerId', 'partyId']);
    }

    // Swaps Collection Rules
    //
    // Every swap mutation uses its callable. This includes declining a
    // legacy proposal: the native counter and item releases share its commit.
    match /swaps/{swapId} {
      // Participants can read their swaps.
      allow read: if isAuthenticated() &&
                     (resource.data.initiatorId == request.auth.uid ||
                      resource.data.receiverId == request.auth.uid);

      // Only Cloud Functions can create swaps (proposeMultiSwap validates
      // article availability, blocking, and cashTopUp via Admin SDK).
      allow create: if false;

      allow update: if false;

      // No client delete — cancellation goes through the cancelSwap callable
      // (which may need to refund a paid top-up via Stripe).
      allow delete: if false;
    }

    // Admin Collection Rules (Admin-only access)
    match /admin/{document=**} {
      // Only allow access for admin users
      allow read, write: if isAuthenticated() && 
                            isAdmin();
    }
    
    // Moderation Collection Rules
    match /moderation/{document=**} {
      // Allow read for moderators
      allow read: if isAuthenticated() && 
                     (isAdmin() ||
                      (request.auth.token.moderator == true && administrativeAccountActive()));
      
      // Allow write for moderators
      allow write: if isAuthenticated() && 
                      (isAdmin() ||
                       (request.auth.token.moderator == true && administrativeAccountActive()));
    }
    
    // Reports Collection Rules
    match /reports/{reportId} {
      // Capture provenance is created atomically by Admin SDK only. A prior
      // client-writable report body is never sufficient to qualify a witness.
      match /native_evidence/{captureId} {
        allow read, write: if false;
      }
      // TRANSITOIRE — la création CLIENTE d'un signalement reste ouverte.
      //
      // Le rail serveur `submitReport` existe, est DÉPLOYÉ, et le client passe
      // désormais par lui : il valide les champs, borne les longueurs, dérive
      // le nom du signaleur du document utilisateur — que le client ne peut pas
      // falsifier — et impose « un signalement par personne et par cible » via
      // un identifiant déterministe posé dans une transaction. Rien de tout
      // cela n'est exprimable dans une règle : un client peut encore signaler
      // cent fois la même cible et se déclarer sous n'importe quel nom.
      //
      // La fermeture est différée pour la même raison que
      // `strictOfferClientWrites()` : le code qui délègue au serveur voyage
      // dans le BUILD, pas dans le déploiement des règles. Les builds installés
      // écrivent encore ici en direct ; fermer maintenant leur ferait perdre le
      // signalement d'article, seul chemin qui fonctionne encore chez eux.
      //
      // À FERMER en même temps que `strictOfferClientWrites()`, en remplaçant
      // ce bloc par `allow create: if false;`.
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.reporterId &&
                       isValidReportData(request.resource.data);
      
      // Allow read for admins and moderators
      allow read: if isAuthenticated() && 
                     (isAdmin() ||
                      (request.auth.token.moderator == true && administrativeAccountActive()));
      
      // Allow update for admins and moderators
      allow update: if isAuthenticated() && 
                       (isAdmin() ||
                        (request.auth.token.moderator == true && administrativeAccountActive())) &&
                       // Native content/media witnesses are callable-owned.
                       // Even an administrative client cannot add, alter or
                       // erase a server capture through a document write.
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['articleEvidence','messageEvidence','contentEvidence','contentSafety','contentDecision']);
      
      function isValidReportData(data) {
        // Aligned with services/moderationService.ts: reports use
        // targetId / targetType / reason. The reason is stored as a
        // ReportReason key (e.g. 'spam', 'harassment') — short strings,
        // bound 1-100 chars.
        // SECURITY (B3): the moderation lifecycle (status / reviewedBy /
        // reviewedAt / resolution) is admin-owned. A reporter must not be able
        // to create a report that is already 'resolved'/'dismissed', nor stamp
        // a fake reviewer. The report must start as 'pending' (or omit status;
        // moderationService defaults to 'pending') and carry no review fields.
        return data.keys().hasAll(['reporterId', 'targetId', 'targetType', 'reason']) &&
               data.reporterId == request.auth.uid &&
               isValidString(data.reason, 1, 100) &&
               data.targetType in ['user', 'article', 'message', 'review'] &&
               (!('status' in data) || data.status == 'pending') &&
               !data.keys().hasAny(['reviewedBy', 'reviewedAt', 'resolution', 'articleEvidence','messageEvidence','contentEvidence','contentSafety','contentDecision']);
      }
    }
    
    // Avis (Reviews) Collection Rules
    match /avis/{reviewId} {
      // Any authenticated user can read reviews
      allow read: if isAuthenticated();

      // Only Cloud Functions can create reviews (createReview callable validates
      // transaction completion and party membership via Admin SDK)
      allow create: if false;

      // No client modification or deletion (managed by Cloud Functions)
      allow update, delete: if false;
    }

    // Analytics Collection Rules (Read-only for admins)
    match /analytics/{document=**} {
      allow read: if isAuthenticated() &&
                     isAdmin();
      allow write: if false; // Managed by Cloud Functions
    }
    
    // Transactions Collection Rules
    match /transactions/{transactionId} {
      // Read only by buyer, seller, or admin. Composite indexes on
      // (buyerId, createdAt) and (sellerId, createdAt) allow efficient
      // filtered list queries.
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.buyerId ||
                      request.auth.uid == resource.data.sellerId ||
                      isAdmin());

      // No client creates — all transaction creation goes through Cloud
      // Functions (Admin SDK bypasses rules).
      allow create: if false;

      // Allow update only by buyer or seller for specific fields
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId) &&
                       isValidTransactionUpdate(resource.data, request.resource.data);

      // No delete allowed
      allow delete: if false;

      function isValidTransactionUpdate(oldData, newData) {
        // SECURITY (F110/F111): payment / shipping / delivery / dispute /
        // fund-release / cancellation transitions are owned by Cloud Functions
        // (stripeWebhook, checkShippedTracking, shipEngineWebhook,
        // releaseHeldFunds, sweepPendingLabels, reconcileFinances,
        // cancelPendingTransaction, adminRefundTransaction). The ONLY
        // client-allowed write is the seller confirming a meetup (peer-to-peer,
        // no money side-effect). Everything else MUST go through a callable so
        // invariants (Stripe, escrow ledger, shipping labels) are enforced
        // atomically.
        //
        // This guard is an ALLOWLIST: a non-meetup-confirmation client write may
        // touch ONLY `updatedAt`. Listing forbidden fields one by one (the old
        // DENYLIST) was fragile — meetup*/noShowReport/shippingAddress/new
        // timestamps could be (and were, F110/F111) forgotten, letting a party
        // mutate the shipping address post-creation or seed arbitrary fields.
        // With an allowlist, ANY field outside the permitted set is rejected by
        // default, so a forgotten field can never become writable.

        // Cannot change core transaction data.
        let coreFieldsUnchanged = newData.articleId == oldData.articleId &&
          newData.buyerId == oldData.buyerId &&
          newData.sellerId == oldData.sellerId &&
          newData.amount == oldData.amount;

        // ALLOWLIST path: only `updatedAt` may change (e.g. an idle re-stamp).
        // Any other key — including ALL the money/shipping/dispute/meetup fields
        // and the shippingAddress (F110) — falls outside this set and is denied,
        // forcing the write through a Cloud Function. The meetup confirmation
        // (below) is the single explicit exception.
        let onlyUpdatedAtTouched =
          newData.diff(oldData).affectedKeys().hasOnly(['updatedAt']);


        // Un client ne peut plus toucher QUE `updatedAt`. La branche qui
        // autorisait le vendeur à écrire lui-même meetup_pending ->
        // meetup_confirmed a été supprimée : plus aucun code applicatif ne
        // l'emprunte depuis le 2026-06-02, date où `confirmMeetup` est passé par
        // la callable `confirmMeetupTransaction`. Elle laissait par ailleurs
        // passer une confirmation SANS auteur — `meetupConfirmedBy`, que le
        // serveur écrit, était hors de l'ensemble de clés autorisé — et sans
        // contrainte d'horodatage, alors que la fenêtre d'avis et le balayage à
        // 7 jours se calent sur `meetupConfirmedAt`.
        return coreFieldsUnchanged && onlyUpdatedAtTouched;
      }
    }
    
    // Wallets Collection Rules
    //
    // Virtual wallet ("porte-monnaie") for buyers and sellers.
    // All balance mutations go through Cloud Functions (Admin SDK).
    // Clients can only READ their own wallet and ledger — no writes.
    match /wallets/{userId} {
      // Allow read only by owner
      allow read: if isOwner(userId);

      // No client writes — Cloud Functions only (Admin SDK bypasses rules)
      allow create, update, delete: if false;

      // Ledger subcollection — read-only for the wallet owner
      match /ledger/{entryId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // Withdrawal Requests Collection — read-only client view of pending
    // / processed withdrawals. Created by walletWithdraw CF.
    match /withdrawal_requests/{withdrawalId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid ||
                      isAdmin());
      allow create, update, delete: if false;
    }

    // Stripe Event Markers — idempotency keys keyed by Stripe event.id, written
    // by the stripeWebhook handler (Admin SDK). No owner concept; never read or
    // written by a client. Fully server-only.
    match /stripe_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Admission foundations: INTERNAL documents may contain signals/notes/DOB.
    // Owners use server callables with allowlisted DTOs; no mixed field-level ACL.
    match /eligibility_profiles/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /eligibility_requests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /eligibility_audit/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Payable shipping preparation: quotes contain private source fingerprints,
    // origin contacts and eligibility lineage; owners use allowlisted callables.
    // Manual-confirmation authorization/unknown outcomes: private server evidence.
    match /stripe_checkout_intents/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /shipping_quotes/{quoteId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /shipping_packages/{articleId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Failed Operations dead-letter queue — written by the writeFailedOperation
    // helper / sweepPendingLabels / reconcileFinances and replayed by
    // retryFailedOperations (all Admin SDK). These docs reference entities via
    // refId but have no per-user owner, and they may carry sensitive payloads
    // (paymentIntentId, amounts). Server-only; admins may inspect.
    match /failed_operations/{opId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Platform Ledger — append-only platform accounting (shipping cost variance,
    // etc.). Server-only; admins may read for tax/audit. No client writes ever.
    match /platform_ledger/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Privacy Incidents register (Loi 25 / RGPD breach log) — written EXCLUSIVELY
    // server-side by the reportPrivacyIncident callable and automated handlers
    // (e.g. deletion_failed in deleteUserAccount), all via the Admin SDK. May
    // carry sensitive payloads (affected UIDs, data fields). Admins may read for
    // incident response and CAI notification tracking. No client writes ever.
    match /privacy_incidents/{incidentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Disputes — buyer-opened "delivered but problem" tickets, created by the
    // reportTransactionProblem callable (Admin SDK). The buyer and seller of the
    // underlying transaction may READ their ticket; admins may read all and
    // resolve. No client writes — creation, status changes and resolution are
    // CF-owned so the linked transaction freeze stays authoritative.
    match /disputes/{disputeId} {
      // `isAdmin()` et non `request.auth.token.admin` : AUCUN code du dépôt
      // n'appelle setCustomUserClaims, donc ce claim est toujours faux et la
      // console de modération (app/admin/disputes.tsx, requête client directe)
      // ne pouvait lire AUCUN litige. Les signalements d'absence — seul recours
      // du parcours meetup, le seul parcours d'achat actif — n'étaient donc
      // visibles de personne. `isAdmin()` reconnaît en plus le champ
      // `users/{uid}.isAdmin`, mécanisme réellement utilisé partout ailleurs et
      // lui-même protégé en écriture (protectedUserFields).
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.buyerId ||
                      request.auth.uid == resource.data.sellerId ||
                      isAdmin());
      allow create, update, delete: if false;
    }

    // Automated-decision transparency log (Loi 25 art. 12.1) — written
    // EXCLUSIVELY server-side by logAutomatedDecision (Admin SDK) from the
    // scheduled jobs (releaseHeldFunds / expireOrphanedTransactions /
    // sweepPendingLabels) AFTER the monetary move. A party (buyer or seller) of
    // the underlying transaction may READ the log entries concerning their
    // transaction; admins may read all. No client writes ever.
    //
    // F113 — the parties are DENORMALISED onto the doc (buyerId/sellerId) by the
    // writer, so the common read path authorises WITHOUT a cross-collection
    // get() (cost/latency, fragile on missing tx). A get() fallback is kept ONLY
    // for legacy docs written before the denormalisation, so the rule still
    // authorises them correctly.
    match /automatic_decisions_log/{logId} {
      allow read: if isAuthenticated() &&
                     (isAdmin() ||
                      ('buyerId' in resource.data &&
                       request.auth.uid == resource.data.buyerId) ||
                      ('sellerId' in resource.data &&
                       request.auth.uid == resource.data.sellerId) ||
                      // Legacy fallback: docs without denormalised parties.
                      (!('buyerId' in resource.data) &&
                       !('sellerId' in resource.data) &&
                       (request.auth.uid ==
                          get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.buyerId ||
                        request.auth.uid ==
                          get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.sellerId)));
      allow create, update, delete: if false;
    }

    // Automated-decision contestations (Loi 25 art. 12.1 right to human review)
    // — opened EXCLUSIVELY by contestAutomatedDecision (Admin SDK). No client
    // CREATE: routing the contestation through the callable guarantees the
    // mandatory side-effects (recordPrivacyIncident admin alert + structured
    // ADMIN_REVIEW log) always fire, which a direct client write would bypass.
    // Reading is restricted to the author and admins. Updates/resolution are
    // CF/admin-only — the contestation reverses NOTHING automatically; a human
    // agent decides the outcome out-of-band.
    match /automated_decision_contestations/{contestationId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.userId ||
                      isAdmin());
      allow create, update, delete: if false;
    }

    // Rate Limit counters — written by the rate-limiter helper (Admin SDK).
    // Internal infrastructure; no client access of any kind.
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }
    
    // Chats Collection Rules
    match /chats/{chatId} {
      // Allow read if user is a participant.
      // resource == null handles get-or-create pattern: when the doc does not
      // exist yet, resource is null and we still need the read to succeed
      // (returns exists()==false) so the client can decide to create it.
      allow read: if isAuthenticated() &&
                     (resource == null || request.auth.uid in resource.data.participants);
      
      // Allow create for authenticated users.
      // SECURITY (M2): a user who has been blocked cannot open a new chat with
      // the person who blocked them. Both participants are checked symmetrically
      // (neither may have blocked the other) via the flat blockedUserIds list;
      // this is defence in depth alongside the Cloud Function / client guards.
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants &&
                       isValidChatData(request.resource.data) &&
                       accountHasNoErasureFence(request.resource.data.participants[0]) &&
                       accountHasNoErasureFence(request.resource.data.participants[1]) &&
                       neitherBlocks(request.resource.data.participants[0],
                                     request.resource.data.participants[1]);
      
      // Allow update only for unread count and last message fields.
      // SECURITY: without field restriction, a participant could overwrite
      // participants, participantsInfo, articleId, etc.
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants &&
                       accountHasNoErasureFence(chatOtherOf(resource.data.participants, request.auth.uid)) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['unreadCount', 'lastMessage', 'lastMessageType', 'lastMessageTimestamp', 'updatedAt']) &&
                       // L'APERÇU est un canal de texte libre vers la liste de
                       // conversations de l'autre. Les règles refusent le MESSAGE
                       // d'une personne bloquée, mais l'aperçu est une écriture
                       // DISTINCTE, sur le document `chats` : sans cette garde, une
                       // personne bloquée pouvait continuer d'afficher son texte et
                       // une pastille de non-lu chez sa victime, indéfiniment, sans
                       // qu'aucun message n'existe dans le fil. Directionnel, pour
                       // que celle qui bloque garde la main sur son propre fil.
                       (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['lastMessage', 'lastMessageType', 'lastMessageTimestamp']) ||
                        (resource.data.get('contentPreviewRestricted', false) == false &&
                         isNotBlockedBy(chatOtherOf(resource.data.participants, request.auth.uid),
                                        request.auth.uid) &&
                         // Borne ANTI-ABUS de l'aperçu, délibérément large.
                         //
                         // Le client tronque désormais à 200 caractères
                         // (`CHAT_PREVIEW_MAX_LENGTH`) — c'est un aperçu d'une
                         // ligne. Mais les BUILDS INSTALLÉS ne tronquent pas, et
                         // les champs de contre-offre n'y ont aucun plafond de
                         // saisie : un message collé pouvait produire un contenu
                         // de plusieurs milliers de caractères. Une borne serrée
                         // aurait refusé cette écriture chez eux — et comme le
                         // compteur de non-lus voyage dans le MÊME `updateDoc`,
                         // le destinataire aurait perdu sa pastille sans que
                         // personne ne comprenne pourquoi.
                         // 2000 ne peut être atteint par aucun usage plausible et
                         // borne malgré tout ce qu'on peut verser dans un document
                         // que les deux parties gardent en écoute permanente.
                         (!('lastMessage' in request.resource.data) ||
                          (request.resource.data.lastMessage is string &&
                           request.resource.data.lastMessage.size() <= 2000))));
      
      // No delete allowed
      allow delete: if false;
      
      function isValidChatData(data) {
        return data.keys().hasAll(['participants', 'participantsInfo', 'unreadCount']) &&
               !data.keys().hasAny(['contentPreviewRestricted']) &&
               data.participants is list &&
               data.participants.size() == 2 &&
               request.auth.uid in data.participants &&
               data.participantsInfo is list &&
               data.unreadCount is map &&
               // Le compteur de non-lus démarre à ZÉRO pour les deux. Il était
               // libre à la création : on pouvait faire naître une conversation
               // avec une pastille déjà à 99 chez l'autre, sans lui avoir écrit.
               (!(data.participants[0] in data.unreadCount) ||
                data.unreadCount[data.participants[0]] == 0) &&
               (!(data.participants[1] in data.unreadCount) ||
                data.unreadCount[data.participants[1]] == 0) &&
               // `sellerId` décide de l'onglet (VENTES / ACHATS / AUTRES) et sert
               // de dérivation du rôle dans la bulle d'offre. Il n'était validé
               // nulle part : on pouvait se déclarer vendeur de l'article d'autrui,
               // ou désigner un tiers étranger à la conversation. Il doit être un
               // participant, et — quand l'article existe — son vrai propriétaire.
               (!('sellerId' in data) ||
                (data.sellerId in data.participants &&
                 (!('articleId' in data) ||
                  !exists(/databases/$(database)/documents/articles/$(data.articleId)) ||
                  get(/databases/$(database)/documents/articles/$(data.articleId)).data.sellerId ==
                    data.sellerId)));
      }
    }
  }
}
