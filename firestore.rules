rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for validation and authorization
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }
    
    function isValidPrice(price) {
      return price is number && price >= 0.01 && price <= 10000;
    }
    
    function isAdmin() {
      // Prefer the `admin` custom claim (set server-side via Admin SDK, not
      // user-writable). Fall back to the Firestore `isAdmin` field for parity
      // with the rest of the codebase (privacyIncidents / search / payments /
      // wallet callables all use this same dual check). The `isAdmin` field on
      // users/{uid} is itself write-protected by the users update rule, so the
      // fallback cannot be self-granted.
      return request.auth != null &&
             (request.auth.token.admin == true ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true));
    }

    // True when `viewerUid` is NOT blocked by `ownerUid`. Reads the owner's
    // user doc via get() (which bypasses the users read rule). Enforcement is
    // based on the flat `blockedUserIds` list (a list of plain UIDs). When that
    // field is absent (doc not yet migrated) the check passes — defence in depth
    // alongside the Cloud Function block guards; it never produces false blocks.
    function isNotBlockedBy(ownerUid, viewerUid) {
      return !(exists(/databases/$(database)/documents/users/$(ownerUid)) &&
               'blockedUserIds' in get(/databases/$(database)/documents/users/$(ownerUid)).data &&
               viewerUid in get(/databases/$(database)/documents/users/$(ownerUid)).data.blockedUserIds);
    }

    // Symmetric block check between two UIDs (neither may have blocked the
    // other). Used wherever a message/chat write must be denied as soon as a
    // block exists in EITHER direction — matching the Cloud Function trigger
    // and services/moderationService.ts semantics.
    function neitherBlocks(uidA, uidB) {
      return isNotBlockedBy(uidA, uidB) && isNotBlockedBy(uidB, uidA);
    }

    // The "other" participant of a 2-party chat, derived from the SERVER chat
    // doc (never from a client-supplied receiverId). Assumes the caller has
    // already verified the chat exists with exactly 2 participants including
    // senderUid. Returns the participant that is not senderUid.
    function chatCounterparty(chatId, senderUid) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0] == senderUid
        ? get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
        : get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0];
    }

    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }
    
    function isValidCondition(condition) {
      return condition in ['neuf', 'très bon état', 'bon état', 'satisfaisant'];
    }
    
    function isValidCoordinates(coords) {
      return coords.keys().hasAll(['lat', 'lon']) &&
             coords.lat is number && coords.lat >= -90 && coords.lat <= 90 &&
             coords.lon is number && coords.lon >= -180 && coords.lon <= 180;
    }
    
    // Shops Collection Rules
    match /shops/{shopId} {
      // Allow read for everyone (to find shops near them)
      allow read: if true;

      // Allow create for authenticated users — but the owner can NEVER
      // self-approve at creation. SECURITY (B1): the validation/moderation
      // status and verification metadata are admin-owned. A new shop must
      // start as 'pending' (or omit status entirely; the service defaults to
      // 'pending'); it may never be created already 'approved'. The paid
      // forfait/plan fields are also admin/Cloud-Function owned: a client must
      // not grant itself a paid tier (which lowers buyer fees) at create time.
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.ownerId &&
                       (!('status' in request.resource.data) ||
                        request.resource.data.status == 'pending') &&
                       !request.resource.data.keys().hasAny(
                         ['verificationDetails', 'plan', 'forfait', 'tier',
                          'tierPaidUntil', 'tierPaymentIntentId', 'tierChargeId',
                          'feesTier', 'buyerFeePercent', 'isVerified']);

      // Allow update either by an admin (full moderation: approve / reject /
      // suspend, set the paid forfait) OR by the owner for non-sensitive
      // fields only. SECURITY (B1/B2/B3): a shop owner can edit their profile
      // (name, description, images, hours, contact…) but can NEVER mutate the
      // validation status, the verification metadata, or the paid forfait /
      // fee tier. Self-approval and self-upgrade are rejected; those mutations
      // are reserved to admins (and Cloud Functions, which bypass these rules).
      allow update: if isAuthenticated() &&
                       (
                         isAdmin() ||
                         (request.auth.uid == resource.data.ownerId &&
                          request.auth.uid == request.resource.data.ownerId &&
                          !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['ownerId', 'status', 'verificationDetails',
                                      'plan', 'forfait', 'tier', 'tierPaidUntil',
                                      'tierPaymentIntentId', 'tierChargeId',
                                      'feesTier', 'buyerFeePercent', 'isVerified']))
                       );

      // No delete allowed (admins suspend via status; hard delete is CF-only).
      allow delete: if false;
    }

    // Brands Collection Rules
    match /brands/{brandId} {
      allow read: if true;
      // Allow authenticated users to create custom brands
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['label', 'value', 'searchKey']) &&
                       request.resource.data.isCustom == true;
      // Update and delete only via admin/script
      allow update, delete: if false;
    }

    // Notifications Collection Rules
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if false; // Only cloud functions can create notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Articles Collection Rules
    match /articles/{articleId} {
      // Public read (browse / discovery uses unauthenticated reads).
      allow read: if true;

      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.sellerId &&
                       isValidArticleData(request.resource.data);

      allow update: if isAuthenticated() &&
                       request.auth.uid == resource.data.sellerId &&
                       isValidArticleUpdate(resource.data, request.resource.data);

      // Soft delete only — owner sets isActive: false. Hard delete still
      // allowed so the existing UI flow that calls delete() keeps
      // working until it's migrated.
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.sellerId;

      function isValidArticleData(data) {
        return data.keys().hasAll(['title', 'price', 'sellerId', 'isActive', 'isSold']) &&
               isValidString(data.title, 3, 200) &&
               isValidPrice(data.price) &&
               data.sellerId == request.auth.uid &&
               data.isActive is bool &&
               data.isSold is bool &&
               (!('description' in data) || isValidString(data.description, 0, 5000)) &&
               // moderationStatus must be 'approved' if provided (auto-approved for now)
               (!('moderationStatus' in data) || data.moderationStatus == 'approved') &&
               // Server-managed counters must start at zero
               (!('views' in data) || data.views == 0) &&
               (!('likes' in data) || data.likes == 0) &&
               (!('likedBy' in data) || data.likedBy.size() == 0) &&
               (!('favoritesCount' in data) || data.favoritesCount == 0);
      }

      function isValidArticleUpdate(oldData, newData) {
        return newData.sellerId == oldData.sellerId &&
               isValidString(newData.title, 3, 200) &&
               isValidPrice(newData.price) &&
               (!('description' in newData) || isValidString(newData.description, 0, 5000)) &&
               // Protect server-managed fields from client mutation
               (!('views' in newData) || newData.views == oldData.views) &&
               (!('likes' in newData) || newData.likes == oldData.likes) &&
               (!('likedBy' in newData) || newData.likedBy == oldData.likedBy) &&
               (!('favoritesCount' in newData) || newData.favoritesCount == oldData.favoritesCount) &&
               (!('moderationStatus' in newData) || newData.moderationStatus == oldData.moderationStatus) &&
               (!('isSold' in newData) || newData.isSold == oldData.isSold);
      }
    }

    // Products Collection Rules
    // DEPRECATED: The client uses `articles` collection exclusively.
    // These rules existed for a legacy `products` collection that is no
    // longer written to or read from by any client code. Locked down to
    // prevent accidental use. Kept as a placeholder until the collection
    // is fully removed from Firestore.
    match /products/{productId} {
      allow read, write: if false;
    }
    
    // Users Collection Rules
    match /users/{userId} {
      // SECURITY: restrict reads to the document owner or admins.
      // Public profile data (displayName, profileImage, rating, etc.) is served
      // via the getUserPublicProfile callable (Admin SDK). Client-side code
      // reading other users' docs (e.g. chatService.ts) must migrate to that
      // callable. BREAKING CHANGE: any direct getDoc(users/X) where X != caller
      // will now fail.
      allow read: if isOwner(userId) || isAdmin();

      // Allow create only with valid initial data. The isAdmin/role/claims
      // fields cannot be set by clients on creation either.
      // SECURITY: `username` is the persistent, unique, immutable handle assigned
      // EXCLUSIVELY server-side by the assignUsername callable (Admin SDK) right
      // after the doc is created. The client creates the users doc WITHOUT a
      // username, so it must be absent at create time.
      //
      // `id` and `createdAt` are the ONLY two fields the client legitimately seeds
      // at create time (the 3 signup setDoc paths write them), so they are removed
      // from the forbidden-at-create set — but kept anti-forge:
      //   - if `id` is present it MUST equal userId (== request.auth.uid via
      //     isOwner), so a client can't seed a foreign id; and
      //   - if `createdAt` is present it MUST equal request.time, which is exactly
      //     what a client serverTimestamp() resolves to at create, blocking any
      //     backdating/forging of the creation timestamp.
      // After creation both are immutable: the update rule still uses the full
      // protectedUserFields() set (which includes id + createdAt).
      allow create: if isOwner(userId) &&
                       isValidUserData(request.resource.data) &&
                       !request.resource.data.keys().hasAny(createForbiddenUserFields()) &&
                       (!('id' in request.resource.data) ||
                          request.resource.data.id == userId) &&
                       (!('createdAt' in request.resource.data) ||
                          request.resource.data.createdAt == request.time);

      // Allow update by owner — but never to fields that grant privileges.
      // SECURITY: previously a user could write { isAdmin: true } to their
      // own document and pass UI-side admin checks. Privileged fields must
      // be set out-of-band (Cloud Function with Admin SDK + Auth custom claim).
      // `username` is in the protected set: it is server-assigned and IMMUTABLE,
      // so a client can never add it, change it, or remove it.
      allow update: if isOwner(userId) &&
                       !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(protectedUserFields());

      // Single source of truth for fields the CLIENT may never set or mutate on
      // its own user doc — applied identically to create and update so a forged
      // initial doc can't bypass the update lock.
      //
      // - isAdmin/role/customClaims : privilege escalation (see isAdmin()).
      // - username                  : server-assigned, persistent, IMMUTABLE handle.
      // - onboardingCompleted/createdAt/id : server-managed lifecycle/identity fields.
      // - stripe*                   : the ONLY financial gates read by walletWithdraw /
      //   createTransaction / swaps. Written EXCLUSIVELY by the Stripe webhook +
      //   onboarding callables (Admin SDK, which bypasses these rules). Leaving them
      //   client-writable let a seller redirect their real payout to a third party's
      //   stripeAccountId and force charges/payouts booleans true to skip KYC.
      // - dateOfBirth               : Loi 25 consent-gate + age-gate, set ONLY in the
      //   server-side signup setDoc; a client must never self-set or alter it.
      // - isVerified/rating/reviewCount/sellerLikesCount : trust signals served by
      //   getUserPublicProfile; server-managed, never client-forgeable.
      //
      // NOTE: accountType ('user' | 'shop') is intentionally NOT protected — it is a
      // legitimate client write (userService.updateAccountType) and is not a financial
      // gate (the seller-active gate keys off stripeAccountId + stripeChargesEnabled).
      function protectedUserFields() {
        return [
          'isAdmin', 'role', 'customClaims', 'username',
          'onboardingCompleted', 'createdAt', 'id',
          'stripeAccountId', 'stripeChargesEnabled', 'stripePayoutsEnabled',
          'stripeAccountStatus', 'stripeDetailsSubmitted', 'stripeBankAccountAdded',
          'stripeBankAccountLast4', 'stripeBankAccountStatus',
          'stripeRequirementsCurrentlyDue', 'stripeRequirementsPastDue',
          'stripeRequirementsDisabledReason', 'stripeRequirementsCurrentDeadline',
          'stripeAccountCreatedAt',
          'dateOfBirth',
          'isVerified', 'rating', 'reviewCount', 'sellerLikesCount'
        ];
      }

      // Fields the CLIENT may never set AT CREATE. Identical to
      // protectedUserFields() MINUS 'id' and 'createdAt', which are the only two
      // privileged-by-default fields a legitimate signup setDoc seeds. They are
      // not free-form at create: the create rule additionally enforces
      // id == userId and createdAt == request.time (see above). Every other
      // privilege/financial/trust field stays forbidden at create, exactly as in
      // protectedUserFields().
      function createForbiddenUserFields() {
        return [
          'isAdmin', 'role', 'customClaims', 'username',
          'onboardingCompleted',
          'stripeAccountId', 'stripeChargesEnabled', 'stripePayoutsEnabled',
          'stripeAccountStatus', 'stripeDetailsSubmitted', 'stripeBankAccountAdded',
          'stripeBankAccountLast4', 'stripeBankAccountStatus',
          'stripeRequirementsCurrentlyDue', 'stripeRequirementsPastDue',
          'stripeRequirementsDisabledReason', 'stripeRequirementsCurrentDeadline',
          'stripeAccountCreatedAt',
          'dateOfBirth',
          'isVerified', 'rating', 'reviewCount', 'sellerLikesCount'
        ];
      }

      // No delete allowed (soft delete by setting isActive = false)
      allow delete: if false;

      function isValidUserData(data) {
        return data.keys().hasAll(['email', 'displayName']) &&
               isValidEmail(data.email) &&
               isValidString(data.displayName, 1, 50);
      }

      // Saved Searches Subcollection Rules
      match /savedSearches/{searchId} {
        // Allow read only by owner
        allow read: if isOwner(userId);

        // Allow create by owner
        allow create: if isOwner(userId);

        // Allow update by owner
        allow update: if isOwner(userId);

        // Allow delete by owner
        allow delete: if isOwner(userId);
      }

      // Search History Subcollection Rules
      match /searchHistory/{historyId} {
        // Allow read only by owner
        allow read: if isOwner(userId);

        // Allow create by owner
        allow create: if isOwner(userId);

        // Allow update by owner — the recent-search dedup path re-stamps an
        // existing entry (e.g. searchedAt) via updateDoc; without this the
        // dedup write is denied. Mirrors the savedSearches update rule above.
        allow update: if isOwner(userId);

        // Allow delete by owner
        allow delete: if isOwner(userId);
      }

      // Consents Subcollection Rules (legal consent records — CGU, politique de
      // confidentialité, marketing). Written EXCLUSIVELY server-side by the
      // recordSignupConsent callable (Admin SDK bypasses these rules) so the
      // acceptedAt timestamp and version stay authoritative and tamper-proof.
      match /consents/{consentId} {
        // Owner may read their own consent history.
        allow read: if isOwner(userId);

        // No client writes — server-only.
        allow create, update, delete: if false;
      }
    }

    // Usernames uniqueness registry — usernames/{username} -> { uid, createdAt }.
    // Reserved and written EXCLUSIVELY server-side by the assignUsername callable
    // (Admin SDK, within a runTransaction) to guarantee atomic uniqueness of the
    // persistent, immutable @handle. Fully server-only: no client read (the
    // mapping leaks nothing useful and a public read would enable username
    // enumeration), no client write of any kind.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Favorites Collection Rules
    // Unified structure: { userId, articleIds[], updatedAt }
    match /favorites/{userId} {
      // Allow read only by owner
      allow read: if isOwner(userId);

      // Allow write by owner with valid data
      allow write: if isOwner(userId) && isValidFavoritesData(request.resource.data);

      function isValidFavoritesData(data) {
        return data.userId == request.auth.uid &&
               data.articleIds is list &&
               data.articleIds.size() <= 500; // Cap at 500 favorites
      }
    }
    
    // Messages Collection Rules
    match /messages/{messageId} {
      // Allow read if:
      //   - the message has a participants list and the caller is in it; OR
      //   - the message lacks participants (legacy docs) BUT the parent
      //     chat doc lists the caller as a participant.
      allow read: if isAuthenticated() &&
                     (
                       ('participants' in resource.data &&
                        request.auth.uid in resource.data.participants) ||
                       ('chatId' in resource.data &&
                        exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
                        request.auth.uid in
                          get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
                     );

      // Allow create if user is the sender with valid data OR it's a system message
      allow create: if isAuthenticated() &&
                       (isValidMessageCreate(request.resource.data) ||
                        isValidSystemMessage(request.resource.data));

      // Allow update for marking as read (isRead + status read receipt) or
      // updating offer status ONLY.
      // SECURITY: restrict to isRead, status and offer fields. When status is
      // modified, it must be a valid MessageStatus. When offer is modified, the
      // offer.amount must stay the same (prevent amount tampering).
      allow update: if isAuthenticated() &&
                       (
                         ('participants' in resource.data &&
                          request.auth.uid in resource.data.participants) ||
                         ('chatId' in resource.data &&
                          exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
                          request.auth.uid in
                            get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants)
                       ) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isRead', 'offer', 'status']) &&
                       // If status is being modified: must be a valid MessageStatus.
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                        request.resource.data.status in ['sending', 'sent', 'delivered', 'read']) &&
                       // If offer is being modified: amount must stay the same.
                       // SECURITY: only the receiver of the offer message can
                       // accept or reject it. The sender may still transition
                       // to 'completed' (post-acceptance meetup flow). For
                       // legacy messages without receiverId we fall back to the
                       // weaker "sender cannot self-accept" check.
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['offer']) ||
                        (request.resource.data.offer.amount == resource.data.offer.amount &&
                         (
                           // Strong check: if receiverId exists, only receiver
                           // can accept/reject the offer.
                           ('receiverId' in resource.data &&
                            (!(request.resource.data.offer.status in ['accepted', 'rejected']) ||
                             request.auth.uid == resource.data.receiverId)) ||
                           // Fallback for legacy messages without receiverId:
                           // at minimum, sender cannot accept their own offer.
                           (!('receiverId' in resource.data) &&
                            !(request.auth.uid == resource.data.senderId &&
                              request.resource.data.offer.status == 'accepted'))
                         )));

      // No delete allowed
      allow delete: if false;

      function isValidMessageCreate(data) {
        return data.senderId == request.auth.uid &&
               data.senderId != data.receiverId &&
               data.type in ['text', 'image', 'offer'] &&
               data.chatId is string &&
               data.participants is list &&
               data.participants.size() == 2 &&
               request.auth.uid in data.participants &&
               // Verify the referenced chat exists and the caller is a participant
               exists(/databases/$(database)/documents/chats/$(data.chatId)) &&
               get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants is list &&
               get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants.size() == 2 &&
               request.auth.uid in get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants &&
               // SECURITY (M2): a blocked user cannot message someone who has
               // blocked them — IN A PRE-EXISTING CHAT TOO. The block check is
               // based on the AUTHORITATIVE counterparty derived from the server
               // chat doc, NOT the client-supplied `receiverId` (which a blocked
               // sender could forge to a third party who hasn't blocked them to
               // slip a message to the real victim). Symmetric: neither side may
               // have blocked the other. The Cloud Function trigger
               // (sendMessageNotification) is the authoritative belt-and-braces
               // guard that also covers any client/rule mismatch.
               neitherBlocks(data.senderId,
                             chatCounterparty(data.chatId, data.senderId)) &&
               // Offer messages must have a valid amount
               (data.type != 'offer' || (data.offer.amount is number && data.offer.amount > 0 && data.offer.amount <= 50000));
      }

      function isValidSystemMessage(data) {
        return data.senderId == 'system' &&
               data.type == 'system' &&
               data.chatId is string &&
               // Verify the referenced chat exists and the caller is a participant
               exists(/databases/$(database)/documents/chats/$(data.chatId)) &&
               request.auth.uid in get(/databases/$(database)/documents/chats/$(data.chatId)).data.participants;
      }
    }
    
    // Stats Collection Rules (Read-only for clients, write via Cloud Functions)
    match /stats/{statType} {
      // Allow read for authenticated users
      allow read: if isAuthenticated();
      
      // No direct writes allowed (managed by Cloud Functions)
      allow write: if false;
    }
    
    // Search Index Collection Rules (Read-only for clients)
    match /search_index/{productId} {
      // Allow read for searching
      allow read: if true;

      // No direct writes allowed (managed by Cloud Functions)
      allow write: if false;
    }

    // Embeddings Collection Rules (for AI-powered similarity search)
    match /embeddings/{articleId} {
      // Allow read for similarity search queries
      allow read: if true;

      // No direct writes allowed (managed by Cloud Functions)
      allow write: if false;
    }

    // Moments Collection Rules (for seasonal/event-based product discovery)
    match /moments/{momentId} {
      // Allow read for moment-based product sections
      allow read: if true;

      // No direct writes allowed (managed by scripts/Cloud Functions)
      allow write: if false;
    }

    // ============================================
    // SWAP SYSTEM RULES
    // ============================================

    // Swap Parties (the single permanent generalist Swap Zone)
    match /swapParties/{partyId} {
      // Anyone can read the zone (counters: itemsCount, swapsCount).
      allow read: if true;

      // Create / update / delete only via Cloud Functions (Admin SDK):
      // ensureGeneralistZone bootstraps the zone; addItemToPartySecure /
      // removeItemFromPartySecure / confirmSwapReception maintain the counters
      // atomically. No client-side writes.
      allow create, update, delete: if false;
    }

    // Swap Zone Items
    // The Swap Zone is open to all — no participants. Depositing an item only
    // requires owning the article. Items are created/removed via Cloud
    // Functions (addItemToPartySecure / removeItemFromPartySecure) which keep
    // itemsCount in sync; the rules below still allow a direct owner write as a
    // safety net but forbid mutating server-managed flags.
    match /swapPartyItems/{itemId} {
      // Anyone can read items in the zone (public discovery + home preview).
      allow read: if true;

      // Owners can add/remove their own items.
      // SECURITY (F112): a direct owner create must NOT be able to short-circuit
      // the addItemToPartySecure Cloud Function by seeding the server-managed
      // swap-lifecycle flags. isSwapped / isPending are CF-owned (Admin SDK), so
      // a client create must leave them absent or forced to false; it may also
      // never seed the CF-managed swap pointers (swapId / swappedWith /
      // swappedAt / pendingSwapId). The owner is pinned to the caller.
      allow create: if isAuthenticated() &&
                       request.resource.data.sellerId == request.auth.uid &&
                       (!('isSwapped' in request.resource.data) ||
                        request.resource.data.isSwapped == false) &&
                       (!('isPending' in request.resource.data) ||
                        request.resource.data.isPending == false) &&
                       !request.resource.data.keys().hasAny(
                         ['swapId', 'swappedWith', 'swappedAt', 'pendingSwapId']);
      allow delete: if isAuthenticated() &&
                       resource.data.sellerId == request.auth.uid;

      // SECURITY: isSwapped and isPending are managed exclusively by Cloud
      // Functions (Admin SDK). Clients cannot mark items swapped or manipulate
      // the pending lock.
      allow update: if isAuthenticated() &&
                       resource.data.sellerId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['isSwapped', 'isPending']);
    }

    // Swaps Collection Rules
    //
    // SECURITY MODEL: all sensitive transitions — payment_pending (top-up
    // accept), accepted (post-payment), photos_pending, shipping, completed,
    // disputed, cancelled — are owned by Cloud Functions (Admin SDK, which
    // bypasses rules). The ONLY client-allowed transition here is a participant
    // declining a 'proposed' swap (a pure social action with no money/state
    // side-effects). Everything else MUST go through a callable so invariants
    // (Stripe payment, escrow ledger, item locks) are enforced atomically.
    match /swaps/{swapId} {
      // Participants can read their swaps.
      allow read: if isAuthenticated() &&
                     (resource.data.initiatorId == request.auth.uid ||
                      resource.data.receiverId == request.auth.uid);

      // Only Cloud Functions can create swaps (proposeMultiSwap validates
      // article availability, blocking, and cashTopUp via Admin SDK).
      allow create: if false;

      // Participants may ONLY decline a proposed swap client-side. All other
      // transitions are CF-only (Admin SDK bypasses these rules).
      allow update: if isAuthenticated() &&
                       (resource.data.initiatorId == request.auth.uid ||
                        resource.data.receiverId == request.auth.uid) &&
                       // Immutable identity + money fields
                       request.resource.data.initiatorId == resource.data.initiatorId &&
                       request.resource.data.receiverId == resource.data.receiverId &&
                       request.resource.data.cashTopUp == resource.data.cashTopUp &&
                       // Only these fields may change in a client decline
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'updatedAt', 'declinedBy', 'declinedAt']) &&
                       // Single permitted transition: proposed -> declined
                       resource.data.status == 'proposed' &&
                       request.resource.data.status == 'declined';

      // No client delete — cancellation goes through the cancelSwap callable
      // (which may need to refund a paid top-up via Stripe).
      allow delete: if false;
    }

    // Admin Collection Rules (Admin-only access)
    match /admin/{document=**} {
      // Only allow access for admin users
      allow read, write: if isAuthenticated() && 
                            request.auth.token.admin == true;
    }
    
    // Moderation Collection Rules
    match /moderation/{document=**} {
      // Allow read for moderators
      allow read: if isAuthenticated() && 
                     (request.auth.token.admin == true || 
                      request.auth.token.moderator == true);
      
      // Allow write for moderators
      allow write: if isAuthenticated() && 
                      (request.auth.token.admin == true || 
                       request.auth.token.moderator == true);
    }
    
    // Reports Collection Rules
    match /reports/{reportId} {
      // Allow create for authenticated users
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.reporterId &&
                       isValidReportData(request.resource.data);
      
      // Allow read for admins and moderators
      allow read: if isAuthenticated() && 
                     (request.auth.token.admin == true || 
                      request.auth.token.moderator == true);
      
      // Allow update for admins and moderators
      allow update: if isAuthenticated() && 
                       (request.auth.token.admin == true || 
                        request.auth.token.moderator == true);
      
      function isValidReportData(data) {
        // Aligned with services/moderationService.ts: reports use
        // targetId / targetType / reason. The reason is stored as a
        // ReportReason key (e.g. 'spam', 'harassment') — short strings,
        // bound 1-100 chars.
        // SECURITY (B3): the moderation lifecycle (status / reviewedBy /
        // reviewedAt / resolution) is admin-owned. A reporter must not be able
        // to create a report that is already 'resolved'/'dismissed', nor stamp
        // a fake reviewer. The report must start as 'pending' (or omit status;
        // moderationService defaults to 'pending') and carry no review fields.
        return data.keys().hasAll(['reporterId', 'targetId', 'targetType', 'reason']) &&
               data.reporterId == request.auth.uid &&
               isValidString(data.reason, 1, 100) &&
               data.targetType in ['user', 'article', 'message', 'review'] &&
               (!('status' in data) || data.status == 'pending') &&
               !data.keys().hasAny(['reviewedBy', 'reviewedAt', 'resolution']);
      }
    }
    
    // Avis (Reviews) Collection Rules
    match /avis/{reviewId} {
      // Any authenticated user can read reviews
      allow read: if isAuthenticated();

      // Only Cloud Functions can create reviews (createReview callable validates
      // transaction completion and party membership via Admin SDK)
      allow create: if false;

      // No client modification or deletion (managed by Cloud Functions)
      allow update, delete: if false;
    }

    // Analytics Collection Rules (Read-only for admins)
    match /analytics/{document=**} {
      allow read: if isAuthenticated() &&
                     request.auth.token.admin == true;
      allow write: if false; // Managed by Cloud Functions
    }
    
    // Transactions Collection Rules
    match /transactions/{transactionId} {
      // Read only by buyer, seller, or admin. Composite indexes on
      // (buyerId, createdAt) and (sellerId, createdAt) allow efficient
      // filtered list queries.
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.buyerId ||
                      request.auth.uid == resource.data.sellerId ||
                      request.auth.token.admin == true);

      // No client creates — all transaction creation goes through Cloud
      // Functions (Admin SDK bypasses rules).
      allow create: if false;

      // Allow update only by buyer or seller for specific fields
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.buyerId ||
                        request.auth.uid == resource.data.sellerId) &&
                       isValidTransactionUpdate(resource.data, request.resource.data);

      // No delete allowed
      allow delete: if false;

      function isValidTransactionUpdate(oldData, newData) {
        // SECURITY: payment / shipping / delivery / dispute / fund-release /
        // cancellation transitions are owned by Cloud Functions (stripeWebhook,
        // checkShippedTracking, shipEngineWebhook, releaseHeldFunds,
        // sweepPendingLabels, reconcileFinances, cancelPendingTransaction,
        // adminRefundTransaction). The ONLY client-allowed write is the seller
        // confirming a meetup (peer-to-peer, no money side-effect). Everything
        // else MUST go through a callable so invariants (Stripe, escrow ledger,
        // shipping labels) are enforced atomically.

        // Cannot change core transaction data.
        let coreFieldsUnchanged = newData.articleId == oldData.articleId &&
          newData.buyerId == oldData.buyerId &&
          newData.sellerId == oldData.sellerId &&
          newData.amount == oldData.amount;

        // SECURITY: server-only sensitive fields. A client must never be able to
        // create, mutate, or remove any of these — they drive money movement,
        // escrow release, shipping, and dispute resolution (all CF-owned via the
        // Admin SDK, which bypasses these rules). diff().affectedKeys() catches
        // adds, edits AND deletes, so listing them in the whitelist below is the
        // primary guard; this is a belt-and-suspenders explicit assertion.
        let sensitiveFieldsUntouched =
          !newData.diff(oldData).affectedKeys().hasAny([
            'status', 'amount', 'totalAmount', 'sellerPayout', 'serviceFee',
            'serviceFeePercent', 'sellerCreditedCents', 'walletAmountUsed',
            'paidVia',
            'shippingCost', 'actualShippingCost', 'shippingCostDelta',
            'insuranceCost', 'shippingReconciledAt',
            'fundsReleaseAt', 'fundsReleasedAt',
            'disputed', 'disputeId', 'disputedAt', 'disputeReason',
            'statusBeforeDispute', 'disputeOutcome', 'disputeClosedAt',
            'buyerReport', 'refundInitiatedAt',
            // Buyer-return leg (B2) — written exclusively by requestReturn /
            // processReturnDelivered (Admin SDK). A buyer is a party to the tx,
            // so without this guard they could forge returnLabelCost (inflate
            // their refund), returnTrackingNumber / returnDeliveredAt (fake the
            // return-delivered refund trigger), or returnReason. All CF-only.
            'returnLabelId', 'returnTrackingNumber', 'returnLabelUrl',
            'returnCarrierCode', 'returnLabelCost', 'returnReason',
            'returnTrackingStatus', 'returnRequestedAt', 'returnDeliveredAt',
            'labelCreationPending', 'labelCreationNote', 'labelAttempts',
            'lastLabelAttemptAt', 'labelStaleNudgedAt',
            'shipEngineRateId', 'shipEngineLabelId', 'trackingNumber',
            'trackingUrl', 'trackingStatus', 'shippingLabelUrl', 'carrierCode',
            'stripePaymentIntentId', 'stripeChargeId', 'stripeRefundId',
            'stripeRefundIssuedAt', 'refundReason', 'refundStartedAt',
            'refundedAt', 'cancelReason', 'cancelledBy', 'cancelledAt',
            'meetupSpot', 'deliveryType',
            'paidAt', 'labelCreatedAt', 'shippedAt', 'deliveredAt',
            'deliveryFailedAt', 'completedAt', 'createdAt'
          ]);

        // Meetup status transition: ONLY the seller can confirm a meetup
        // (meetup_pending -> meetup_confirmed). The meetup_confirmed ->
        // meetup_completed transition is CF-only (completeMeetupTransaction),
        // which unlocks the review. The status field is in the sensitive list
        // above, so when a meetup confirmation happens we permit ONLY the exact
        // key set {status, meetupConfirmedAt, updatedAt} and re-validate it.
        //
        // SECURITY (P1-5): the canonical path is the confirmMeetupTransaction
        // callable (Admin SDK, runTransaction) which stamps meetupConfirmedAt +
        // meetupConfirmedBy server-side. The client-side seller fallback MAY
        // carry meetupConfirmedAt; when it does it MUST be a timestamp so a
        // seller cannot stamp a forged / non-timestamp confirmation time (which
        // the 7d expiry sweep and the review unlock both key off). The key set
        // is still bounded to {status, meetupConfirmedAt, updatedAt} so no other
        // field can ride along, and the transition is restricted to the seller
        // moving meetup_pending -> meetup_confirmed.
        let isMeetupConfirmation =
          oldData.status == 'meetup_pending' &&
          newData.status == 'meetup_confirmed' &&
          request.auth.uid == oldData.sellerId &&
          newData.diff(oldData).affectedKeys()
            .hasOnly(['status', 'meetupConfirmedAt', 'updatedAt']) &&
          (!('meetupConfirmedAt' in newData) ||
           newData.meetupConfirmedAt is timestamp);

        // Path A: no sensitive field touched (e.g. updatedAt-only writes).
        // Path B: the single legitimate meetup confirmation by the seller.
        return coreFieldsUnchanged &&
          (sensitiveFieldsUntouched || isMeetupConfirmation);
      }
    }
    
    // Wallets Collection Rules
    //
    // Virtual wallet ("porte-monnaie") for buyers and sellers.
    // All balance mutations go through Cloud Functions (Admin SDK).
    // Clients can only READ their own wallet and ledger — no writes.
    match /wallets/{userId} {
      // Allow read only by owner
      allow read: if isOwner(userId);

      // No client writes — Cloud Functions only (Admin SDK bypasses rules)
      allow create, update, delete: if false;

      // Ledger subcollection — read-only for the wallet owner
      match /ledger/{entryId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // Withdrawal Requests Collection — read-only client view of pending
    // / processed withdrawals. Created by walletWithdraw CF.
    match /withdrawal_requests/{withdrawalId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid ||
                      request.auth.token.admin == true);
      allow create, update, delete: if false;
    }

    // Stripe Event Markers — idempotency keys keyed by Stripe event.id, written
    // by the stripeWebhook handler (Admin SDK). No owner concept; never read or
    // written by a client. Fully server-only.
    match /stripe_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Failed Operations dead-letter queue — written by the writeFailedOperation
    // helper / sweepPendingLabels / reconcileFinances and replayed by
    // retryFailedOperations (all Admin SDK). These docs reference entities via
    // refId but have no per-user owner, and they may carry sensitive payloads
    // (paymentIntentId, amounts). Server-only; admins may inspect.
    match /failed_operations/{opId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Platform Ledger — append-only platform accounting (shipping cost variance,
    // etc.). Server-only; admins may read for tax/audit. No client writes ever.
    match /platform_ledger/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Privacy Incidents register (Loi 25 / RGPD breach log) — written EXCLUSIVELY
    // server-side by the reportPrivacyIncident callable and automated handlers
    // (e.g. deletion_failed in deleteUserAccount), all via the Admin SDK. May
    // carry sensitive payloads (affected UIDs, data fields). Admins may read for
    // incident response and CAI notification tracking. No client writes ever.
    match /privacy_incidents/{incidentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Disputes — buyer-opened "delivered but problem" tickets, created by the
    // reportTransactionProblem callable (Admin SDK). The buyer and seller of the
    // underlying transaction may READ their ticket; admins may read all and
    // resolve. No client writes — creation, status changes and resolution are
    // CF-owned so the linked transaction freeze stays authoritative.
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.buyerId ||
                      request.auth.uid == resource.data.sellerId ||
                      request.auth.token.admin == true);
      allow create, update, delete: if false;
    }

    // Automated-decision transparency log (Loi 25 art. 12.1) — written
    // EXCLUSIVELY server-side by logAutomatedDecision (Admin SDK) from the
    // scheduled jobs (releaseHeldFunds / expireOrphanedTransactions /
    // sweepPendingLabels) AFTER the monetary move. A party (buyer or seller) of
    // the underlying transaction may READ the log entries concerning their
    // transaction; admins may read all. No client writes ever.
    match /automatic_decisions_log/{logId} {
      allow read: if isAuthenticated() &&
                     (request.auth.token.admin == true ||
                      request.auth.uid ==
                        get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.buyerId ||
                      request.auth.uid ==
                        get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.sellerId);
      allow create, update, delete: if false;
    }

    // Automated-decision contestations (Loi 25 art. 12.1 right to human review)
    // — opened EXCLUSIVELY by contestAutomatedDecision (Admin SDK). No client
    // CREATE: routing the contestation through the callable guarantees the
    // mandatory side-effects (recordPrivacyIncident admin alert + structured
    // ADMIN_REVIEW log) always fire, which a direct client write would bypass.
    // Reading is restricted to the author and admins. Updates/resolution are
    // CF/admin-only — the contestation reverses NOTHING automatically; a human
    // agent decides the outcome out-of-band.
    match /automated_decision_contestations/{contestationId} {
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.userId ||
                      request.auth.token.admin == true);
      allow create, update, delete: if false;
    }

    // Rate Limit counters — written by the rate-limiter helper (Admin SDK).
    // Internal infrastructure; no client access of any kind.
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }
    
    // Chats Collection Rules
    match /chats/{chatId} {
      // Allow read if user is a participant.
      // resource == null handles get-or-create pattern: when the doc does not
      // exist yet, resource is null and we still need the read to succeed
      // (returns exists()==false) so the client can decide to create it.
      allow read: if isAuthenticated() &&
                     (resource == null || request.auth.uid in resource.data.participants);
      
      // Allow create for authenticated users.
      // SECURITY (M2): a user who has been blocked cannot open a new chat with
      // the person who blocked them. Both participants are checked symmetrically
      // (neither may have blocked the other) via the flat blockedUserIds list;
      // this is defence in depth alongside the Cloud Function / client guards.
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants &&
                       isValidChatData(request.resource.data) &&
                       neitherBlocks(request.resource.data.participants[0],
                                     request.resource.data.participants[1]);
      
      // Allow update only for unread count and last message fields.
      // SECURITY: without field restriction, a participant could overwrite
      // participants, participantsInfo, articleId, etc.
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['unreadCount', 'lastMessage', 'lastMessageType', 'lastMessageTimestamp', 'updatedAt']);
      
      // No delete allowed
      allow delete: if false;
      
      function isValidChatData(data) {
        return data.keys().hasAll(['participants', 'participantsInfo', 'unreadCount']) &&
               data.participants is list &&
               data.participants.size() == 2 &&
               request.auth.uid in data.participants &&
               data.participantsInfo is list &&
               data.unreadCount is map;
      }
    }
  }
}



