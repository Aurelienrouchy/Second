# =============================================================================
# Cloud Functions — Environment Variables
# Copy to .env and fill in your API keys
# =============================================================================

# --- ShipEngine (Shipping API — multi-carrier) ---
# Create account: https://www.shipengine.com/pricing/
# Start with Free plan (sandbox), then Advanced ($75/mo) for production
# Connect carriers: Intelcom CA + Canada Post in ShipEngine dashboard
SHIPENGINE_API_KEY=
SHIPENGINE_BASE_URL=https://api.shipengine.com

# --- Helcim (Payment Processing) ---
# Create account: https://www.helcim.com/developer-api/
# Get API token from: Helcim Dashboard → Settings → API Access
HELCIM_API_TOKEN=
HELCIM_BASE_URL=https://api.helcim.com

# --- Frais de protection acheteur (modèle Vinted : 0% vendeur) ---
# Formule : max(BUYER_FEE_MIN, articlePrice × BUYER_FEE_PERCENT% + BUYER_FEE_FIXED)
BUYER_FEE_PERCENT=5
BUYER_FEE_FIXED=1.50
BUYER_FEE_MIN=2.00

# --- Legacy: Intelcom Direct API (kept for migration) ---
# Only needed if NOT using ShipEngine
# INTELCOM_API_KEY=
# INTELCOM_CLIENT_CODE=
# INTELCOM_BASE_URL=https://api.intelcomexpress.com

# --- Legacy: Stripe (replaced by Helcim) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
