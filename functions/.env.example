# Copy to .env.seconde-dev for the dedicated cloud development project.
# Firebase CLI chooses the file from the explicit --project argument.
# Keep credentials in Secret Manager on THAT project, never in this file.
SECONDE_ENV=development
SECONDE_PROJECT_ID=seconde-dev
PAYMENTS_ENABLED=false
SHIPPING_ENABLED=false
# Optional public Application ID, only for the Square Sandbox pilot on seconde-dev.
SQUARE_SANDBOX_APPLICATION_ID=

# Production-only configuration belongs in .env.seconde-b47a6.
# Do not keep a shared functions/.env: it would be read for both targets.
