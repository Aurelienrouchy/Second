{
  "name": "seconde-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Freepe marketplace",
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/checkFinancialWriterRegistry.cjs && tsc && node scripts/checkFinancialWriterRegistry.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill:usernames": "tsc -p scripts/tsconfig.json && node lib-scripts/backfillUsernames.js",
    "backfill:usernames:dry": "tsc -p scripts/tsconfig.json && node lib-scripts/backfillUsernames.js --dry-run",
    "prepack": "npm run build",
    "test:integration": "node scripts/testEmulatorIntegrations.cjs",
    "test:integration:v1": "node scripts/testEmulatorIntegrations.cjs --v1-core"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^6.1.0",
    "@google-cloud/storage": "7.18.0",
    "@google/genai": "^1.37.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.3",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^10.5.0",
    "posthog-node": "^5.40.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.2.0",
    "vitest": "^4.1.7"
  },
  "private": true
}
