{
  "name": "seconde",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "test-auth": "node --no-warnings ./scripts/test-auth.js",
    "test-firebase-auth": "node --no-warnings ./scripts/test-firebase-auth.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:boundaries": "npx eslint --quiet --rule 'boundaries/dependencies: error' 'features/**/*.{ts,tsx}' 'app/**/*.{ts,tsx}' 'hooks/**/*.{ts,tsx}' 'services/**/*.{ts,tsx}' 'store/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' 'utils/**/*.{ts,tsx}' 'contexts/**/*.{ts,tsx}'",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:all": "eas build --platform all --profile development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:functions": "cd functions && npx vitest run",
    "test:all": "npm run test && npm run test:unit && npm run test:functions && npm run test:security",
    "test:security:run": "vitest run --config tests/security/vitest.config.ts",
    "test:security": "firebase emulators:exec --only firestore,storage,auth 'npm run test:security:run'"
  },
  "expo": {
    "install": {
      "exclude": [
        "@stripe/stripe-react-native",
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@composio/mcp": "^1.0.9",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/ui": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@stripe/stripe-react-native": "^0.66.0",
    "@tanstack/react-query": "^5.90.5",
    "dotenv": "^17.2.1",
    "expo": "^56.0.8",
    "expo-apple-authentication": "~56.0.4",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.16",
    "expo-camera": "~56.0.7",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-image-manipulator": "~56.0.16",
    "expo-image-picker": "~56.0.15",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-location": "~56.0.15",
    "expo-network": "~56.0.4",
    "expo-notifications": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-sharing": "~56.0.15",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "geofire-common": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-places-autocomplete": "^2.6.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "use-debounce": "^10.0.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@firebase/firestore": "^4.9.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google/generative-ai": "^0.24.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.15",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "xhr2": "^0.2.1"
  },
  "private": true
}
