{
  "name": "seconde",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "test-auth": "node --no-warnings ./scripts/test-auth.js",
    "test-firebase-auth": "node --no-warnings ./scripts/test-firebase-auth.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:boundaries": "npx eslint --quiet --rule 'boundaries/dependencies: error' 'features/**/*.{ts,tsx}' 'app/**/*.{ts,tsx}' 'hooks/**/*.{ts,tsx}' 'services/**/*.{ts,tsx}' 'store/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' 'utils/**/*.{ts,tsx}' 'contexts/**/*.{ts,tsx}'",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:all": "eas build --platform all --profile development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:functions": "cd functions && npx vitest run",
    "test:all": "npm run test && npm run test:functions && npm run test:security",
    "test:security:run": "vitest run --config tests/security/vitest.config.ts",
    "test:security": "firebase emulators:exec --only firestore,storage,auth 'npm run test:security:run'"
  },
  "dependencies": {
    "@composio/mcp": "^1.0.9",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/dev-server": "^0.5.5",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/core": "^7.16.2",
    "@react-navigation/elements": "^2.9.11",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@react-navigation/stack": "^7.4.7",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@stripe/stripe-react-native": "^0.66.0",
    "@tanstack/react-query": "^5.90.5",
    "dotenv": "^17.2.1",
    "expo": "^55.0.8",
    "expo-apple-authentication": "~55.0.9",
    "expo-blur": "~55.0.10",
    "expo-build-properties": "~55.0.10",
    "expo-camera": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.10",
    "expo-dev-client": "~55.0.18",
    "expo-device": "~55.0.10",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-image-manipulator": "~55.0.11",
    "expo-image-picker": "~55.0.13",
    "expo-linear-gradient": "~55.0.9",
    "expo-linking": "~55.0.8",
    "expo-location": "~55.1.4",
    "expo-maps": "~55.0.11",
    "expo-network": "~55.0.14",
    "expo-notifications": "~55.0.13",
    "expo-router": "~55.0.7",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "geofire-common": "^6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-places-autocomplete": "^2.6.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "use-debounce": "^10.0.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/firestore": "^4.9.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google/generative-ai": "^0.24.1",
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.6.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "xhr2": "^0.2.1"
  },
  "private": true
}
