{
  "name": "seconde",
  "main": "./index",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/start-dev.cjs",
    "start:dev-client": "node scripts/start-dev.cjs --dev-client",
    "start:emulators": "node scripts/start-dev.cjs --emulators --dev-client",
    "deploy:dev": "node scripts/deploy-dev.cjs",
    "reset-project": "node ./scripts/reset-project.js",
    "test-auth": "node --no-warnings ./scripts/test-auth.js",
    "test-firebase-auth": "node --no-warnings ./scripts/test-firebase-auth.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "lint:boundaries": "npx eslint --quiet --rule 'boundaries/dependencies: error' 'features/**/*.{ts,tsx}' 'app/**/*.{ts,tsx}' 'hooks/**/*.{ts,tsx}' 'services/**/*.{ts,tsx}' 'store/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' 'utils/**/*.{ts,tsx}'",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:all": "eas build --platform all --profile development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:functions": "cd functions && npx vitest run",
    "test:all": "npm run test && npm run test:unit && npm run test:functions && npm run test:security",
    "test:security:run": "vitest run --config tests/security/vitest.config.ts",
    "test:security:firestore:run": "FIREBASE_RULES_FIRESTORE_ONLY=1 vitest run --config tests/security/vitest.config.ts",
    "test:security": "firebase emulators:exec --project demo-second --only firestore,storage,auth 'npm run test:security:run'",
    "test:e2e": "maestro test .maestro/flows",
    "import:brands": "node scripts/import-brands.js",
    "import:brands:dry": "node scripts/import-brands.js --dry-run"
  },
  "expo": {
    "install": {
      "exclude": [
        "@stripe/stripe-react-native",
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@stripe/stripe-react-native": "^0.66.0",
    "@tanstack/react-query": "^5.90.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.1",
    "expo": "~57.0.34",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.24",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.25",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.23",
    "expo-image-picker": "~57.0.22",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.26",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.27",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "geofire-common": "^6.0.0",
    "posthog-react-native": "^4.54.4",
    "react": "19.2.3",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.6.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@firebase/firestore": "^4.9.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@google/generative-ai": "^0.24.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.15",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-boundaries": "^6.0.2",
    "expo-mcp": "~0.2.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "knip": "^6.15.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5",
    "xhr2": "^0.2.1"
  },
  "private": true
}
