rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reusable validators
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isReasonableImageSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }
    function isValidImageUpload() {
      return isImage() && isReasonableImageSize();
    }
    function ownsArticle(articleId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/articles/$(articleId))
        && firestore.get(/databases/(default)/documents/articles/$(articleId)).data.sellerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/articles/$(articleId)).data.isSold == false
        && hasNoLiveArticleLink(firestore.get(/databases/(default)/documents/articles/$(articleId)).data);
    }
    function hasNoLiveArticleLink(article) {
      return !('activeTransactionId' in article) || article.activeTransactionId == null ||
        (article.activeTransactionId is string && article.activeTransactionId != ''
          && firestore.exists(/databases/(default)/documents/transactions/$(article.activeTransactionId))
          && firestore.get(/databases/(default)/documents/transactions/$(article.activeTransactionId)).data.status
            in ['cancelled', 'refunded', 'completed', 'meetup_completed']);
    }
    function participatesInChat(chatId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }
    function participatesInSwap(swapId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/swaps/$(swapId))
        && request.auth.uid in [
          firestore.get(/databases/(default)/documents/swaps/$(swapId)).data.initiatorId,
          firestore.get(/databases/(default)/documents/swaps/$(swapId)).data.receiverId
        ];
    }

    // Allow authenticated users to upload images to their own folders
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null || isValidImageUpload());
    }

    // Product images — uid-scoped path: products/{userId}/{productId}/...
    // This path is currently unused in the codebase but prepared for future use.
    match /products/{userId}/{productId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null || isValidImageUpload());
    }

    // Publication creates the article server-side; local images first stage in
    // products/{uid}/... . Existing article edits use the authoritative owner.
    match /articles/{articleId}/{allPaths=**} {
      allow read: if true; // Public read for article images
      allow write: if ownsArticle(articleId)
                   && (request.resource == null || isValidImageUpload());
    }

    // Draft images (for AI analysis) — scoped by userId
    match /drafts/{userId}/{draftId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null || isValidImageUpload());
    }

    // Allow authenticated users to upload avatars
    match /avatars/{userId} {
      allow read: if true; // Public read for avatars
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null || isValidImageUpload());
    }

    // Chat media is private to the authoritative participants and immutable.
    match /chat_images/{chatId}/{allPaths=**} {
      allow read: if participatesInChat(chatId);
      // An upload can be evaluated as create even when it replaces an object.
      // Explicitly check the existing resource to preserve immutable media.
      allow create: if resource == null && participatesInChat(chatId) && isValidImageUpload();
      allow update, delete: if false;
    }

    // Legacy proofs remain readable by participants, never mutable.
    match /swaps/{swapId}/photos/{allPaths=**} {
      allow read: if participatesInSwap(swapId);
      allow write: if false;
    }
    // New proofs bind the uploader via a UID segment and are create-only.
    match /swaps/{swapId}/photos/{userId}/{fileName} {
      allow read: if participatesInSwap(swapId);
      allow create: if resource == null && participatesInSwap(swapId)
        && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/swaps/$(swapId)).data.status == 'photos_pending'
        && isValidImageUpload();
      allow update, delete: if false;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
